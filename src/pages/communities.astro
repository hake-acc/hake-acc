---
// src/pages/communities.astro — Managed Creator Communities Showcase
import HakeLayout from "@/layouts/HakeLayout.astro";
---

<HakeLayout
  title="Managed Creator Communities — hake."
  description="Take a look inside the Discord servers, bot setups, and creator community hubs architected and managed by Hake."
  activePage="communities"
>
  <!-- Subpage Header -->
  <header class="subpage-header-section">
    <span class="subpage-eyebrow">CREATOR NETWORK</span>
    <h1 class="subpage-title">
      Engineered For 100,000+ Gaming Enthusiasts
    </h1>
    <p class="subpage-subtitle">
      Explore the Discord servers and community hubs managed behind the scenes. Each ecosystem is custom-architected for security, member engagement, and long-term creator equity.
    </p>

    <div class="subpage-stat-row">
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>6 Featured Creator Hubs</span>
      </div>
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>100K+ Combined Reach</span>
      </div>
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>Zero Raid Incidents</span>
      </div>
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>99.9% Bot Ecosystem Uptime</span>
      </div>
    </div>
  </header>

  <!-- Main Content Flow -->
  <div class="subpage-content-wrap">

    <!-- Communities Grid -->
    <section class="communities-grid" aria-label="Creator Communities">
      
      <!-- Community 1: CappuMCXD -->
      <article class="community-showcase-card">
        <div class="community-card-banner">
          <img src="/creators/cappuxd.webp" alt="CappuMCXD" class="community-card-avatar" width="64" height="64" loading="lazy" />
        </div>
        <div class="community-card-body">
          <h2 class="community-card-title">CappuMCXD</h2>
          <span class="community-card-genre">Minecraft Gaming &amp; Entertainment</span>

          <div class="community-stat-chips">
            <span class="community-chip">17.7K Subscribers</span>
            <span class="community-chip">18K+ Discord Members</span>
          </div>

          <p class="community-card-desc">
            Complete architectural overhaul of an 18,000-member community. Reorganized 45+ cluttered channels into 8 focused categories, established custom ticket support, and implemented strict AutoMod defenses.
          </p>

          <ul class="community-features-list">
            <li>&bull; Streamlined channel flow &amp; intuitive category layout</li>
            <li>&bull; Private ticket system with automatic transcript logs</li>
            <li>&bull; VIP supporter tiers &amp; custom reward roles</li>
            <li>&bull; Zero spam raids since architecture overhaul</li>
          </ul>

          <a href="https://youtube.com/@cappumcxd?si=iX9f89vV74tN7zVp" target="_blank" rel="noopener noreferrer" class="community-action-btn">
            <span>View YouTube Channel</span>
            <span style="color: var(--accent-blue);">↗</span>
          </a>
        </div>
      </article>

      <!-- Community 2: Alex Adi XD -->
      <article class="community-showcase-card">
        <div class="community-card-banner">
          <img src="/creators/alex-adi-xd.webp" alt="Alex Adi XD" class="community-card-avatar" width="64" height="64" loading="lazy" />
        </div>
        <div class="community-card-body">
          <h2 class="community-card-title">Alex Adi XD</h2>
          <span class="community-card-genre">Creator Community &amp; Fan Hub</span>

          <div class="community-stat-chips">
            <span class="community-chip">1.79K Subscribers</span>
            <span class="community-chip">12K+ Discord Members</span>
          </div>

          <p class="community-card-desc">
            Engineered a structured onboarding flow with instant YouTube upload webhooks, active discussion lounges, and volunteer moderation protocols that keep the server friendly and active.
          </p>

          <ul class="community-features-list">
            <li>&bull; Sub-second video upload alert webhooks</li>
            <li>&bull; Frictionless rule acceptance &amp; verification gate</li>
            <li>&bull; Volunteer moderator training &amp; shift logs</li>
            <li>&bull; Brand integration and sponsor shoutout channels</li>
          </ul>

          <a href="https://youtube.com/@alexadixdofficial?si=aLvcFWUEtfCFZa3n" target="_blank" rel="noopener noreferrer" class="community-action-btn">
            <span>View YouTube Channel</span>
            <span style="color: var(--accent-blue);">↗</span>
          </a>
        </div>
      </article>

      <!-- Community 3: MC Thunder Playz -->
      <article class="community-showcase-card">
        <div class="community-card-banner">
          <img src="/creators/mc-thunder-playz.webp" alt="MC Thunder Playz" class="community-card-avatar" width="64" height="64" loading="lazy" />
        </div>
        <div class="community-card-body">
          <h2 class="community-card-title">MC Thunder Playz</h2>
          <span class="community-card-genre">Multiplayer Gaming &amp; Events</span>

          <div class="community-stat-chips">
            <span class="community-chip">1.05K Subscribers</span>
            <span class="community-chip">15K+ Discord Members</span>
          </div>

          <p class="community-card-desc">
            High-traffic gaming community equipped with temporary dynamic voice lobbies, community game night announcement pipelines, and role-based access for Minecraft events.
          </p>

          <ul class="community-features-list">
            <li>&bull; Auto-generating voice channels to eliminate clutter</li>
            <li>&bull; Community Minecraft tournaments &amp; prize channels</li>
            <li>&bull; Anti-invite link filter and anti-phishing protection</li>
            <li>&bull; Self-assignable ping roles for events &amp; uploads</li>
          </ul>

          <a href="https://youtube.com/@mcthunderxdofficial?si=ZLA57BXmSrlSPx9J" target="_blank" rel="noopener noreferrer" class="community-action-btn">
            <span>View YouTube Channel</span>
            <span style="color: var(--accent-blue);">↗</span>
          </a>
        </div>
      </article>

      <!-- Community 4: Arpan GamzO -->
      <article class="community-showcase-card">
        <div class="community-card-banner">
          <img src="/creators/arpan-gamzo.webp" alt="Arpan GamzO" class="community-card-avatar" width="64" height="64" loading="lazy" />
        </div>
        <div class="community-card-body">
          <h2 class="community-card-title">Arpan GamzO</h2>
          <span class="community-card-genre">Creator Alerts &amp; Streaming Hub</span>

          <div class="community-stat-chips">
            <span class="community-chip">7.46K Subscribers</span>
            <span class="community-chip">8.5K+ Discord Members</span>
          </div>

          <p class="community-card-desc">
            Built an alert-driven community server featuring real-time stream announcements, clip sharing showcases, and leveling incentives that reward chat engagement with VIP status.
          </p>

          <ul class="community-features-list">
            <li>&bull; Multi-platform YouTube &amp; stream notification bot</li>
            <li>&bull; Level-based reward roles &amp; chat incentives</li>
            <li>&bull; Dedicated fan clips &amp; video suggestion board</li>
            <li>&bull; Staff resolution response time under 15 minutes</li>
          </ul>

          <a href="https://youtube.com/@arpangamzo_official?si=xtwSqSXOWGjZKe9B" target="_blank" rel="noopener noreferrer" class="community-action-btn">
            <span>View YouTube Channel</span>
            <span style="color: var(--accent-blue);">↗</span>
          </a>
        </div>
      </article>

      <!-- Community 5: Not Vangid -->
      <article class="community-showcase-card">
        <div class="community-card-banner">
          <img src="/creators/not-vangid.webp" alt="Not Vangid" class="community-card-avatar" width="64" height="64" loading="lazy" />
        </div>
        <div class="community-card-body">
          <h2 class="community-card-title">Not Vangid</h2>
          <span class="community-card-genre">Minecraft Server Operations</span>

          <div class="community-stat-chips">
            <span class="community-chip">1.87K Subscribers</span>
            <span class="community-chip">5.2K+ Discord Members</span>
          </div>

          <p class="community-card-desc">
            Designed an operational hub bridging Minecraft in-game servers with Discord. Includes live player count bots, server status monitors, and structured bug ticketing.
          </p>

          <ul class="community-features-list">
            <li>&bull; Live server IP status &amp; player count widget</li>
            <li>&bull; Dedicated bug submission &amp; staff feedback channels</li>
            <li>&bull; Player appeal ticketing with staff escalation</li>
            <li>&bull; Private developer &amp; builder coordination backstages</li>
          </ul>

          <a href="https://youtube.com/@notvangid?si=u0Xvy79AwXL5CP1S" target="_blank" rel="noopener noreferrer" class="community-action-btn">
            <span>View YouTube Channel</span>
            <span style="color: var(--accent-blue);">↗</span>
          </a>
        </div>
      </article>

      <!-- Community 6: Sky Plays -->
      <article class="community-showcase-card">
        <div class="community-card-banner">
          <img src="/creators/sky-plays.webp" alt="Sky Plays" class="community-card-avatar" width="64" height="64" loading="lazy" />
        </div>
        <div class="community-card-body">
          <h2 class="community-card-title">Sky Plays</h2>
          <span class="community-card-genre">Gaming Hub &amp; Media Sharing</span>

          <div class="community-stat-chips">
            <span class="community-chip">10K+ Community Reach</span>
            <span class="community-chip">Gaming Discussion</span>
          </div>

          <p class="community-card-desc">
            Fast-paced community hub with strict AutoMod rate limits to prevent spam, organized media galleries for creator memes, and creator discussion stages.
          </p>

          <ul class="community-features-list">
            <li>&bull; AutoMod spam &amp; repeated message protection</li>
            <li>&bull; Organized media gallery for community art &amp; memes</li>
            <li>&bull; Creator stage lounge for subscriber voice Q&amp;As</li>
            <li>&bull; Dynamic ping roles for live gameplay alerts</li>
          </ul>

          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="community-action-btn">
            <span>View YouTube Channel</span>
            <span style="color: var(--accent-blue);">↗</span>
          </a>
        </div>
      </article>
    </section>

    <!-- Architecture Standard Matrix -->
    <section style="background-color: var(--card-elevated); border: 1px solid var(--border-line); border-radius: 24px; padding: 40px; margin-bottom: 64px;" aria-label="Feature Matrix">
      <div style="text-align: center; max-width: 600px; margin: 0 auto 32px;">
        <span class="subpage-eyebrow">STANDARDS &amp; PROTOCOLS</span>
        <h2 style="font-family: var(--font-heading); font-size: 26px; font-weight: 800; color: var(--text-main); margin-bottom: 8px;">
          What Every Managed Server Includes
        </h2>
        <p style="font-size: 14px; color: var(--text-muted);">
          Every community architected by Hake follows these baseline security and engagement standards.
        </p>
      </div>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 14px; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-line);">
              <th style="padding: 12px 16px; font-family: var(--font-heading); font-weight: 700; color: var(--text-main);">Standard Feature</th>
              <th style="padding: 12px 16px; font-family: var(--font-heading); font-weight: 700; color: var(--text-main);">Purpose &amp; Benefit</th>
              <th style="padding: 12px 16px; font-family: var(--font-heading); font-weight: 700; color: var(--text-main); text-align: center;">Status</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border-line);">
              <td style="padding: 14px 16px; font-weight: 600; color: var(--text-main);">Anti-Raid Verification Gate</td>
              <td style="padding: 14px 16px; color: var(--text-muted);">Prevents malicious bot joins and automated DM advertising spam.</td>
              <td style="padding: 14px 16px; text-align: center; color: var(--accent-green); font-weight: 700;">Default 100%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-line);">
              <td style="padding: 14px 16px; font-weight: 600; color: var(--text-main);">Automated Stream &amp; Video Alerts</td>
              <td style="padding: 14px 16px; color: var(--text-muted);">Sub-second notification delivery with rich visual embeds and no failed pings.</td>
              <td style="padding: 14px 16px; text-align: center; color: var(--accent-green); font-weight: 700;">Default 100%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-line);">
              <td style="padding: 14px 16px; font-weight: 600; color: var(--text-main);">Private Staff Ticketing System</td>
              <td style="padding: 14px 16px; color: var(--text-muted);">Member support, ban appeals, and sponsor inquiries with HTML transcript logs.</td>
              <td style="padding: 14px 16px; text-align: center; color: var(--accent-green); font-weight: 700;">Default 100%</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-line);">
              <td style="padding: 14px 16px; font-weight: 600; color: var(--text-main);">Strict Role Permissions Matrix</td>
              <td style="padding: 14px 16px; color: var(--text-muted);">Eliminates @everyone misuse, unauthorized webhooks, and channel leaks.</td>
              <td style="padding: 14px 16px; text-align: center; color: var(--accent-green); font-weight: 700;">Default 100%</td>
            </tr>
            <tr>
              <td style="padding: 14px 16px; font-weight: 600; color: var(--text-main);">Weekly Health &amp; Retention Audit</td>
              <td style="padding: 14px 16px; color: var(--text-muted);">Actionable metrics on active chatters, voice utilization, and growth pacing.</td>
              <td style="padding: 14px 16px; text-align: center; color: var(--accent-green); font-weight: 700;">Default 100%</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Bottom CTA Card -->
    <section style="background: linear-gradient(135deg, var(--card-elevated) 0%, var(--card-bg) 100%); border: 1px solid var(--border-line); border-radius: 24px; padding: 48px; text-align: center; box-shadow: var(--shadow-card);">
      <h2 style="font-family: var(--font-heading); font-size: clamp(24px, 3vw, 36px); font-weight: 800; color: var(--text-main); margin-bottom: 12px;">
        Want Your Community Architected Like These?
      </h2>
      <p style="font-size: 15px; color: var(--text-muted); max-width: 580px; margin: 0 auto 28px; line-height: 1.6;">
        Let's build an organized, high-retention Discord server that keeps your fans engaged and takes the operational headaches off your plate.
      </p>
      <a href="/contact" class="btn-primary-action" style="font-size: 16px; padding: 14px 36px;">
        <span>Let's Work Together &rarr;</span>
      </a>
    </section>

  </div>
</HakeLayout>
