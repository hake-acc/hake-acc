---
import Layout from "@/layouts/Layout.astro";
import content from "@/data/content.json";
import Hero from "@/components/Hero";
import ExecutivePitch from "@/components/ExecutivePitch";
import Sidebar from "@/components/Sidebar";
import Navigation from "@/components/Navigation";
import About from "@/components/About";
import Projects from "@/components/Projects";
import BeforeAfterSlider from "@/components/BeforeAfterSlider";
import ChannelDefenderGame from "@/components/ChannelDefenderGame";
import TerminalSimulator from "@/components/TerminalSimulator";
import GrowthCalculator from "@/components/GrowthCalculator";
import Skills from "@/components/Skills";
import Experience from "@/components/Experience";
import Services from "@/components/Services";
import Testimonials from "@/components/Testimonials";
import ContactForm from "@/components/ContactForm";
import Footer from "@/components/Footer";
import SectionDivider from "@/components/SectionDivider";
---

<Layout
  title="Hake Acc — Senior Content Strategist & Discord Architect"
  description="Official portfolio of Hake Acc. Senior content strategist and Discord architect managing top YouTubers, scaling communities, and engineering high-retention creator ecosystems."
>
  <Sidebar client:media="(min-width: 1024px)" />
  <div class="lg:pl-[220px] flex flex-col min-h-screen">
    <Navigation client:idle />
    
    <main id="main-content" class="flex-1">
      <Hero client:load data={content.hero} contact={content.contact} />

      {/* 15-Second Executive Hiring Pitch */}
      <ExecutivePitch client:visible />
      
      <SectionDivider color="#f59e0b" />

      {/* Touch/Mouse Draggable Before/After Comparison Slider */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <BeforeAfterSlider client:visible />
      </section>

      <SectionDivider color="#38bdf8" />

      {/* Retro Arcade Mini-Game: Channel Defender */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <ChannelDefenderGame client:visible />
      </section>

      <SectionDivider color="#818cf8" />

      {/* Interactive Micro-Interactions Showcase: Terminal Simulator */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <div class="mb-6 text-center">
          <p class="section-label mb-2">// INTERACTIVE CONSOLE</p>
          <h2 class="text-2xl sm:text-3xl font-bold font-retro text-text-main">
            Test The Discord Bot &amp; Agency Systems
          </h2>
        </div>
        <TerminalSimulator client:visible />
      </section>

      <SectionDivider color="#f59e0b" />
      <About client:visible data={content.about} />
      
      <SectionDivider color="#38bdf8" />
      <Projects client:visible data={content.projects} />

      {/* Interactive Growth Calculator */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <GrowthCalculator client:visible />
      </section>
      
      <SectionDivider color="#818cf8" />
      <Skills client:visible data={content.skills} />
      
      <SectionDivider color="#f59e0b" />
      <Experience client:visible data={content.experience} />
      
      <SectionDivider color="#38bdf8" />
      <Services client:visible data={content.services} />
      
      <SectionDivider color="#818cf8" />
      <Testimonials client:visible data={content.testimonials} />
      
      <SectionDivider color="#f59e0b" />
      <ContactForm client:visible data={content.contact} />
    </main>
    
    <Footer client:visible />
  </div>
</Layout>
