---
import Layout from "@/layouts/Layout.astro";
import content from "@/data/content.json";
import Sidebar from "@/components/Sidebar";
import Navigation from "@/components/Navigation";
import Services from "@/components/Services";
import BeforeAfterSlider from "@/components/BeforeAfterSlider";
import GrowthCalculator from "@/components/GrowthCalculator";
import Testimonials from "@/components/Testimonials";
import Footer from "@/components/Footer";
import SectionDivider from "@/components/SectionDivider";
import PageNav from "@/components/PageNav";
---

<Layout
  title="Services & Agency Solutions — Hake Acc"
  description="Comprehensive YouTube channel management, high-security Discord server architecture, Shorts scaling, and creator monetization solutions."
>
  <Sidebar client:load />
  <div class="lg:pl-[220px] flex flex-col min-h-screen">
    <Navigation client:load />
    
    <main id="main-content" class="flex-1 pt-16 lg:pt-0">
      {/* Page Header */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber/15 border border-amber/30 rounded text-amber font-silkscreen text-xs mb-4">
          <span class="w-2 h-2 rounded-sm bg-amber" />
          <span>SOLUTIONS &amp; DELIVERABLES</span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-retro text-text-main leading-tight mb-4">
          Comprehensive Creator
          <br />
          <span class="gradient-text">Growth Systems.</span>
        </h1>
        <p class="text-text-muted text-sm sm:text-base md:text-lg max-w-2xl mx-auto font-readable leading-relaxed">
          From YouTube thumbnail packaging and upload workflows to custom Discord bots and multi-platform monetization.
        </p>
      </section>

      {/* Services Grid */}
      <Services client:load data={content.services} />

      <SectionDivider color="#818cf8" />

      {/* Interactive Before & After Comparator */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <BeforeAfterSlider client:visible />
      </section>

      <SectionDivider color="#38bdf8" />

      {/* In-Depth Service Matrix */}
      <section class="py-16 sm:py-20 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <div class="text-center mb-12">
          <p class="section-label mb-2">// SCOPE &amp; DELIVERABLES</p>
          <h2 class="text-3xl sm:text-4xl font-bold font-retro text-text-main">
            What Every Service Includes
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 font-readable">
          {/* Service 1 */}
          <div class="pixel-hud-card rounded-xl p-6 sm:p-8 border-t-4 border-cyan bg-[#131622]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold font-retro text-text-main">
                YouTube Channel Management
              </h3>
              <span class="pixel-badge bg-cyan/15 border border-cyan/30 text-cyan">
                FULL SUITE
              </span>
            </div>
            <p class="text-text-muted text-xs sm:text-sm leading-relaxed mb-4">
              Complete ownership of your YouTube upload pipeline, metadata, and packaging to guarantee maximum viewer retention.
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-text-muted">
              <li class="flex items-center gap-2"><span class="text-cyan font-retro text-[9px]">▶</span> Thumbnail A/B packaging &amp; design art direction</li>
              <li class="flex items-center gap-2"><span class="text-cyan font-retro text-[9px]">▶</span> Video title hook testing &amp; high-CTR formulations</li>
              <li class="flex items-center gap-2"><span class="text-cyan font-retro text-[9px]">▶</span> Deep video SEO: search tags, cards &amp; end-screens</li>
              <li class="flex items-center gap-2"><span class="text-cyan font-retro text-[9px]">▶</span> Community tab marketing &amp; subscriber polling</li>
            </ul>
          </div>

          {/* Service 2 */}
          <div class="pixel-hud-card rounded-xl p-6 sm:p-8 border-t-4 border-purple bg-[#131622]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold font-retro text-text-main">
                Discord Server Architecture
              </h3>
              <span class="pixel-badge bg-purple/15 border border-purple/30 text-purple">
                HIGH SECURITY
              </span>
            </div>
            <p class="text-text-muted text-xs sm:text-sm leading-relaxed mb-4">
              Design, deployment, and security hardening of high-engagement Discord hubs built to turn viewers into loyal superfans.
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-text-muted">
              <li class="flex items-center gap-2"><span class="text-purple font-retro text-[9px]">▶</span> Anti-nuke &amp; anti-raid security permissions hardening</li>
              <li class="flex items-center gap-2"><span class="text-purple font-retro text-[9px]">▶</span> Custom bot logic, economy &amp; gamified leveling</li>
              <li class="flex items-center gap-2"><span class="text-purple font-retro text-[9px]">▶</span> Automated YouTube &amp; Twitch stream alert channels</li>
              <li class="flex items-center gap-2"><span class="text-purple font-retro text-[9px]">▶</span> VIP subscriber role assignment &amp; Nitro booster perks</li>
            </ul>
          </div>

          {/* Service 3 */}
          <div class="pixel-hud-card rounded-xl p-6 sm:p-8 border-t-4 border-amber bg-[#131622]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold font-retro text-text-main">
                Shorts &amp; Multi-Platform Scaling
              </h3>
              <span class="pixel-badge bg-amber/15 border border-amber/30 text-amber">
                VIRAL GROWTH
              </span>
            </div>
            <p class="text-text-muted text-xs sm:text-sm leading-relaxed mb-4">
              Repurpose long-form content into viral clips on YouTube Shorts, TikTok, and Instagram Reels to flood top-of-funnel discovery.
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-text-muted">
              <li class="flex items-center gap-2"><span class="text-amber font-retro text-[9px]">▶</span> High-intensity clip extraction from streams/videos</li>
              <li class="flex items-center gap-2"><span class="text-amber font-retro text-[9px]">▶</span> Dynamic subtitle styling, sound effects &amp; pacing</li>
              <li class="flex items-center gap-2"><span class="text-amber font-retro text-[9px]">▶</span> Trend audio alignment &amp; viral hook positioning</li>
              <li class="flex items-center gap-2"><span class="text-amber font-retro text-[9px]">▶</span> Cross-platform syndication across all short-form apps</li>
            </ul>
          </div>

          {/* Service 4 */}
          <div class="pixel-hud-card rounded-xl p-6 sm:p-8 border-t-4 border-success bg-[#131622]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold font-retro text-text-main">
                Creator Agency &amp; Monetization
              </h3>
              <span class="pixel-badge bg-success/15 border border-success/30 text-success">
                REVENUE MAX
              </span>
            </div>
            <p class="text-text-muted text-xs sm:text-sm leading-relaxed mb-4">
              Transform audience attention into revenue through brand sponsorships, merchandise, and membership tiers.
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-text-muted">
              <li class="flex items-center gap-2"><span class="text-success font-retro text-[9px]">▶</span> Brand sponsorship pitch deck creation &amp; rate cards</li>
              <li class="flex items-center gap-2"><span class="text-success font-retro text-[9px]">▶</span> Sponsor read script review &amp; post-campaign analytics</li>
              <li class="flex items-center gap-2"><span class="text-success font-retro text-[9px]">▶</span> Patreon &amp; YouTube Channel Memberships setup</li>
              <li class="flex items-center gap-2"><span class="text-success font-retro text-[9px]">▶</span> Creator affiliate marketing funnels &amp; tracking links</li>
            </ul>
          </div>
        </div>
      </section>

      <SectionDivider color="#f59e0b" />

      {/* Growth Calculator Section */}
      <section class="py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <GrowthCalculator client:visible />
      </section>

      <SectionDivider color="#818cf8" />

      {/* Testimonials preview */}
      <Testimonials client:visible data={content.testimonials} />

      {/* Sequence Page Nav */}
      <PageNav client:load prevHref="/projects" prevLabel="Channels Showcase" nextHref="/experience" nextLabel="Experience & Stack" />
    </main>
    
    <Footer client:visible />
  </div>
</Layout>
