---
// src/pages/services.astro - Comprehensive Creator Services & Discord Architecture
import HakeLayout from "@/layouts/HakeLayout.astro";
---

<HakeLayout
  title="Services & Deliverables | hake."
  description="Explore comprehensive Discord server architecture, automated bot setups, video editing coordination, and creator talent operations by Hake."
  activePage="services"
>
  <!-- Subpage Header -->
  <header class="subpage-header-section">
    <span class="subpage-eyebrow">SERVICES &amp; DELIVERABLES</span>
    <h1 class="subpage-title">
      Engineering High-Retention Creator Operations
    </h1>
    <p class="subpage-subtitle">
      I manage the operational weight behind fast-growing YouTubers and gaming communities. From ground-up Discord server restructures to video editing coordination and sponsor deal flows.
    </p>

    <div class="subpage-stat-row">
      <div class="subpage-stat-pill">
        <span>6 Core Operational Deliverables</span>
      </div>
      <div class="subpage-stat-pill">
        <span>24h Direct Discord Response</span>
      </div>
      <div class="subpage-stat-pill">
        <span>100K+ Community Reach</span>
      </div>
      <div class="subpage-stat-pill">
        <span>Zero-Fluff Execution</span>
      </div>
    </div>
  </header>

  <!-- Main Content Flow -->
  <div class="subpage-content-wrap">
    
    <!-- 6 Deep-Dive Service Cards -->
    <section class="services-deepdive-grid" aria-label="Core Services">
      
      <!-- Service 1: Discord Architecture -->
      <article class="service-deep-card">
        <div class="service-card-top">
          <div class="service-card-icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
          </div>
          <span class="service-badge-num">01 / ARCHITECTURE</span>
        </div>
        <h2 class="service-deep-title">Custom Discord Server Architecture</h2>
        <p class="service-deep-desc">
          Most creator Discord servers are messy, cluttered, and overwhelming for new members. I rebuild servers with intuitive category pacing, clear channel functions, and rock-solid permission hierarchies.
        </p>

        <ul class="service-deliverables-list">
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Streamlined category hierarchy (8-10 focused categories max, no channel clutter)</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Granular role permission matrix preventing unauthorized pings and role leaks</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Frictionless onboarding flow with rule acceptance verification</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Custom formatted announcement &amp; rules embeds with branded aesthetic headers</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Dedicated booster lounges, VIP patron tiers, and private creator staff backstages</span>
          </li>
        </ul>

        <div class="service-tags-row">
          <span class="service-tech-pill">Discord API</span>
          <span class="service-tech-pill">Permission Auditing</span>
          <span class="service-tech-pill">Discohook Formatting</span>
          <span class="service-tech-pill">Channel UX</span>
        </div>
      </article>

      <!-- Service 2: Bot Automation -->
      <article class="service-deep-card">
        <div class="service-card-top">
          <div class="service-card-icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <span class="service-badge-num">02 / AUTOMATION</span>
        </div>
        <h2 class="service-deep-title">Automated Community Bot Ecosystems</h2>
        <p class="service-deep-desc">
          A server shouldn't require you to be online 24/7 to stay safe and active. I set up automated moderation, custom webhooks, role selection, and instant notification systems that keep the server running autonomously.
        </p>

        <ul class="service-deliverables-list">
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Multi-layered AutoMod: anti-spam, malicious phishing shields, and invite link filtering</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Interactive reaction roles for upload alerts, game roles, and event notifications</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Private staff ticket system with automatic transcript saving for appeals and disputes</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Sub-second YouTube &amp; Twitch stream alert webhooks with customized rich embeds</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Automated leveling loops with custom perks for high-activity community members</span>
          </li>
        </ul>

        <div class="service-tags-row">
          <span class="service-tech-pill">AutoMod</span>
          <span class="service-tech-pill">Ticket Tool</span>
          <span class="service-tech-pill">Sapphire / Carl-bot</span>
          <span class="service-tech-pill">Webhooks</span>
        </div>
      </article>

      <!-- Service 3: Video Editing Coordination -->
      <article class="service-deep-card">
        <div class="service-card-top">
          <div class="service-card-icon-box">
            <lord-icon
              class="hake-lord-icon"
              src="https://cdn.lordicon.com/qfwgmyhc.json"
              trigger="loop"
              loading="lazy"
              colors="primary:#0055ee,secondary:#38bdf8"
              style="width:30px;height:30px"
              aria-hidden="true">
            </lord-icon>
          </div>
          <span class="service-badge-num">03 / PRODUCTION</span>
        </div>
        <h2 class="service-deep-title">Video Editing &amp; Thumbnail Coordination</h2>
        <p class="service-deep-desc">
          You film the footage; I help coordinate with editors, review drafts, and ensure videos are packaged for high click-through rates and peak viewer retention without missing upload deadlines.
        </p>

        <ul class="service-deliverables-list">
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Centralized Notion &amp; Trello pipeline for footage handoffs, notes, and revision rounds</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>First 30-second hook reviews and pacing audits before final creator sign-off</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Thumbnail concept variations with high-contrast framing and readable mobile typography</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Upload schedule enforcement ensuring edits are delivered 24 hours ahead of drop</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Video metadata packaging: titles, SEO descriptions, timestamp chapters, and end cards</span>
          </li>
        </ul>

        <div class="service-tags-row">
          <span class="service-tech-pill">Pacing Audits</span>
          <span class="service-tech-pill">Thumbnail Packaging</span>
          <span class="service-tech-pill">Notion Workflows</span>
          <span class="service-tech-pill">Editor Management</span>
        </div>
      </article>

      <!-- Service 4: Sponsorship & Brand Deals -->
      <article class="service-deep-card">
        <div class="service-card-top">
          <div class="service-card-icon-box">
            <lord-icon
              class="hake-lord-icon"
              src="https://cdn.lordicon.com/zhiiqoue.json"
              trigger="loop"
              loading="lazy"
              colors="primary:#0055ee,secondary:#38bdf8"
              style="width:30px;height:30px"
              aria-hidden="true">
            </lord-icon>
          </div>
          <span class="service-badge-num">04 / REVENUE</span>
        </div>
        <h2 class="service-deep-title">Sponsorships &amp; Brand Deal Management</h2>
        <p class="service-deep-desc">
          Managing brand emails is time-consuming and full of shady outreach. I screen legitimate sponsors, negotiate favorable rates, manage contract checklists, and ensure deliverables are tracked accurately.
        </p>

        <ul class="service-deliverables-list">
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Business email inbox screening to filter out scam promos and sketchy software</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Updated creator media kit with accurate monthly analytics, view averages, and demographics</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Negotiation of competitive flat-rate and CPM pricing for integrated sponsorships</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Tracking talking points, discount codes, tracked URLs, and upload compliance dates</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Post-campaign metrics delivery and invoicing follow-up for timely creator payouts</span>
          </li>
        </ul>

        <div class="service-tags-row">
          <span class="service-tech-pill">Brand Vetting</span>
          <span class="service-tech-pill">Media Kits</span>
          <span class="service-tech-pill">Rate Negotiation</span>
          <span class="service-tech-pill">Contract Tracking</span>
        </div>
      </article>

      <!-- Service 5: Social Media Strategy -->
      <article class="service-deep-card">
        <div class="service-card-top">
          <div class="service-card-icon-box">
            <lord-icon
              class="hake-lord-icon"
              src="https://cdn.lordicon.com/rpviwvwn.json"
              trigger="loop"
              loading="lazy"
              colors="primary:#0055ee,secondary:#38bdf8"
              style="width:30px;height:30px"
              aria-hidden="true">
            </lord-icon>
          </div>
          <span class="service-badge-num">05 / STRATEGY</span>
        </div>
        <h2 class="service-deep-title">Community Growth &amp; Content Pacing</h2>
        <p class="service-deep-desc">
          Building a loyal audience requires converting casual YouTube viewers into active community participants. I develop simple cross-platform pacing calendars and event structures that keep fans engaged between video releases.
        </p>

        <ul class="service-deliverables-list">
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Clear conversion funnels directing YouTube pinned comments to specific Discord events</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Teaser clip scheduling on Twitter/X and community tabs leading up to premier drops</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Bi-weekly community game nights, Minecraft build contests, and creator Q&amp;A sessions</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Community meme and fan art curation channels feeding content back into YouTube videos</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Staff team management: hiring, onboarding, and training trusted volunteer moderators</span>
          </li>
        </ul>

        <div class="service-tags-row">
          <span class="service-tech-pill">Community Events</span>
          <span class="service-tech-pill">Fan Retention</span>
          <span class="service-tech-pill">Mod Training</span>
          <span class="service-tech-pill">Content Pacing</span>
        </div>
      </article>

      <!-- Service 6: Retention Reporting -->
      <article class="service-deep-card">
        <div class="service-card-top">
          <div class="service-card-icon-box">
            <lord-icon
              class="hake-lord-icon"
              src="https://cdn.lordicon.com/lbcxnxti.json"
              trigger="loop"
              loading="lazy"
              colors="primary:#0055ee,secondary:#38bdf8"
              style="width:30px;height:30px"
              aria-hidden="true">
            </lord-icon>
          </div>
          <span class="service-badge-num">06 / ANALYTICS</span>
        </div>
        <h2 class="service-deep-title">Community Analytics &amp; Retention Auditing</h2>
        <p class="service-deep-desc">
          Know exactly what is working in your community. I track key engagement metrics (active daily chatters, voice channel peak hours, and member churn), delivering actionable weekly summaries without vanity metric fluff.
        </p>

        <ul class="service-deliverables-list">
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Weekly Discord Server Insights reports highlighting active message volume and growth</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Voice channel utilization mapping to identify ideal times for streams and events</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Member retention analysis to pinpoint why new joins become inactive after 7 days</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Moderation log reviews tracking ticket resolution speeds and flagged automod triggers</span>
          </li>
          <li class="deliverable-item">
            <span class="deliverable-check">✓</span>
            <span>Actionable recommendations to revive quiet channels and optimize role incentives</span>
          </li>
        </ul>

        <div class="service-tags-row">
          <span class="service-tech-pill">Server Insights</span>
          <span class="service-tech-pill">Churn Prevention</span>
          <span class="service-tech-pill">Weekly Reports</span>
          <span class="service-tech-pill">Actionable Data</span>
        </div>
      </article>
    </section>

    <!-- 4-Step Process Roadmap -->
    <section class="roadmap-section" aria-label="Process Workflow">
      <div style="text-align: center; max-width: 600px; margin: 0 auto;">
        <span class="subpage-eyebrow">HOW WE WORK</span>
        <h2 style="font-family: var(--font-heading); font-size: 28px; font-weight: 800; color: var(--text-main); margin-bottom: 10px;">
          The 4-Step Operations Workflow
        </h2>
        <p style="font-size: 14.5px; color: var(--text-muted);">
          A disciplined, step-by-step approach that prevents chaos and ensures your community setup is bulletproof from day one.
        </p>
      </div>

      <div class="roadmap-grid">
        <div class="roadmap-step-card">
          <span class="roadmap-step-badge">1</span>
          <h3 class="roadmap-step-title">Audit &amp; Bottlenecks</h3>
          <p class="roadmap-step-desc">
            We review your current Discord server, permissions, moderation backlog, and creator workflows to identify exactly what is broken or inefficient.
          </p>
        </div>

        <div class="roadmap-step-card">
          <span class="roadmap-step-badge">2</span>
          <h3 class="roadmap-step-title">Architecture Blueprint</h3>
          <p class="roadmap-step-desc">
            I draft a clean category layout, role hierarchy wireframe, and bot requirement checklist customized to your specific content style and community size.
          </p>
        </div>

        <div class="roadmap-step-card">
          <span class="roadmap-step-badge">3</span>
          <h3 class="roadmap-step-title">Setup &amp; Hardening</h3>
          <p class="roadmap-step-desc">
            I configure channels, write clear embed guidelines, configure automod defenses, set up alert webhooks, and test permissions across all roles.
          </p>
        </div>

        <div class="roadmap-step-card">
          <span class="roadmap-step-badge">4</span>
          <h3 class="roadmap-step-title">Handoff &amp; Ongoing Ops</h3>
          <p class="roadmap-step-desc">
            I train your moderators, establish simple daily moderation protocols, and remain on call to handle ongoing maintenance, bot updates, and events.
          </p>
        </div>
      </div>
    </section>

    <!-- Service Packages / Engagement Options -->
    <section class="pricing-section" aria-label="Service Packages">
      <div style="text-align: center; max-width: 600px; margin: 0 auto;">
        <span class="subpage-eyebrow">ENGAGEMENT MODELS</span>
        <h2 style="font-family: var(--font-heading); font-size: 28px; font-weight: 800; color: var(--text-main); margin-bottom: 10px;">
          Tailored Options For Every Creator Stage
        </h2>
        <p style="font-size: 14.5px; color: var(--text-muted);">
          Transparent, straightforward scopes designed for creators looking for immediate fixes or ongoing monthly management.
        </p>
      </div>

      <div class="pricing-cards-grid">
        <!-- Tier 1 -->
        <div class="pricing-card">
          <h3 class="pricing-tier-name">Server Overhaul</h3>
          <p class="pricing-tier-desc">Complete one-time restructuring of your existing Discord server or fresh ground-up build.</p>

          <ul class="pricing-features-list">
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Full channel &amp; category overhaul</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Permissions security matrix</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>AutoMod spam &amp; raid hardening</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Reaction roles &amp; ticket system</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Formatted rules &amp; info embeds</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>14 days of post-launch tuning</span>
            </li>
          </ul>

          <a href="/contact?service=Discord+Server+Setup" class="btn-primary-action" style="justify-content: center; width: 100%;">
            <span>Inquire About Overhaul</span>
          </a>
        </div>

        <!-- Tier 2 (Featured) -->
        <div class="pricing-card featured">
          <span class="pricing-badge-popular">Most Requested</span>
          <h3 class="pricing-tier-name">Community Ops Retainer</h3>
          <p class="pricing-tier-desc">Dedicated monthly operations management keeping your community secure, active, and running smoothly.</p>

          <ul class="pricing-features-list">
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Everything in Server Overhaul</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Daily moderation oversight &amp; tickets</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>YouTube upload notification pings</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Bi-weekly community events coordination</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Weekly retention &amp; chat health reports</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Direct Discord DM priority support</span>
            </li>
          </ul>

          <a href="/contact?service=Community+Management" class="btn-primary-action" style="justify-content: center; width: 100%;">
            <span>Inquire About Retainer</span>
          </a>
        </div>

        <!-- Tier 3 -->
        <div class="pricing-card">
          <h3 class="pricing-tier-name">Full Creator Operations</h3>
          <p class="pricing-tier-desc">End-to-end management covering community, editing timelines, and sponsor inbound vetting.</p>

          <ul class="pricing-features-list">
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Everything in Community Ops</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Video editor pipeline coordination</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Thumbnail variation review &amp; CTR focus</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Sponsorship screening &amp; negotiation</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Contract deliverable compliance checks</span>
            </li>
            <li class="pricing-feature-item">
              <span style="color: var(--accent-green);">✓</span>
              <span>Dedicated 24/7 creator operations partner</span>
            </li>
          </ul>

          <a href="/contact?service=Full+Management" class="btn-primary-action" style="justify-content: center; width: 100%;">
            <span>Inquire About Full Suite</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Bottom CTA Card -->
    <section style="margin-top: 48px; background: linear-gradient(135deg, var(--card-elevated) 0%, var(--card-bg) 100%); border: 1px solid var(--border-line); border-radius: 24px; padding: 48px; text-align: center; box-shadow: var(--shadow-card);">
      <h2 style="font-family: var(--font-heading); font-size: clamp(24px, 3vw, 36px); font-weight: 800; color: var(--text-main); margin-bottom: 12px;">
        Ready To Take Your Community To The Next Level?
      </h2>
      <p style="font-size: 15px; color: var(--text-muted); max-width: 580px; margin: 0 auto 28px; line-height: 1.6;">
        Let's discuss what your channel or gaming server needs. Direct communication, realistic expectations, and zero corporate fluff.
      </p>
      <a href="/contact" class="btn-primary-action" style="font-size: 16px; padding: 14px 36px;">
        <span>Let's Work Together &rarr;</span>
      </a>
    </section>

  </div>
</HakeLayout>
