---
import Layout from "@/layouts/Layout.astro";
import content from "@/data/content.json";
import Sidebar from "@/components/Sidebar";
import Navigation from "@/components/Navigation";
import Services from "@/components/Services";
import GrowthCalculator from "@/components/GrowthCalculator";
import Testimonials from "@/components/Testimonials";
import Footer from "@/components/Footer";
import SectionDivider from "@/components/SectionDivider";
---

<Layout
  title="Services & Agency Solutions — Hake Acc"
  description="Comprehensive YouTube channel management, high-security Discord server architecture, Shorts scaling, and creator monetization solutions."
>
  <Sidebar client:load />
  <div class="lg:pl-[220px] flex flex-col min-h-screen">
    <Navigation client:load />
    
    <main id="main-content" class="flex-1 pt-20">
      {/* Page Header */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-accent/15 border border-accent/30 rounded text-accent font-silkscreen text-xs mb-4">
          <span class="w-2 h-2 rounded-sm bg-accent animate-pulse" />
          <span>SOLUTIONS &amp; DELIVERABLES</span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-retro text-text-main leading-tight mb-4">
          Comprehensive Creator
          <br />
          <span class="gradient-text">Growth Systems.</span>
        </h1>
        <p class="text-text-muted text-sm sm:text-base md:text-lg max-w-2xl mx-auto font-pixel leading-relaxed">
          From YouTube thumbnail packaging and upload workflows to custom Discord bots and multi-platform monetization.
        </p>
      </section>

      {/* Services Grid */}
      <Services client:load data={content.services} />

      <SectionDivider color="#8B7CF6" />

      {/* In-Depth Service Matrix */}
      <section class="py-16 sm:py-20 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <div class="text-center mb-12">
          <p class="section-label mb-2">// SCOPE &amp; DELIVERABLES</p>
          <h2 class="text-3xl sm:text-4xl font-bold font-retro text-text-main">
            What Every Service Includes
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {/* Service 1 */}
          <div class="pixel-card rounded-xl p-6 sm:p-8 border-t-4 border-[#6AA9FF]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold font-retro text-text-main">
                YouTube Channel Management
              </h3>
              <span class="pixel-badge bg-[#6AA9FF]/15 border border-[#6AA9FF]/30 text-[#6AA9FF]">
                FULL SUITE
              </span>
            </div>
            <p class="text-text-muted text-xs sm:text-sm font-pixel leading-relaxed mb-4">
              Complete ownership of your YouTube upload pipeline, metadata, and packaging to guarantee maximum viewer retention.
            </p>
            <ul class="space-y-2 text-xs sm:text-sm font-pixel text-text-muted">
              <li class="flex items-center gap-2"><span class="text-[#6AA9FF] font-retro text-[9px]">▶</span> Thumbnail A/B packaging &amp; design art direction</li>
              <li class="flex items-center gap-2"><span class="text-[#6AA9FF] font-retro text-[9px]">▶</span> Video title hook testing &amp; high-CTR formulations</li>
              <li class="flex items-center gap-2"><span class="text-[#6AA9FF] font-retro text-[9px]">▶</span> Deep video SEO: search tags, cards &amp; end-screens</li>
              <li class="flex items-center gap-2"><span class="text-[#6AA9FF] font-retro text-[9px]">▶</span> Community tab marketing &amp; subscriber polling</li>
            </ul>
          </div>

          {/* Service 2 */}
          <div class="pixel-card rounded-xl p-6 sm:p-8 border-t-4 border-[#8B7CF6]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold font-retro text-text-main">
                Discord Server Architecture
              </h3>
              <span class="pixel-badge bg-[#8B7CF6]/15 border border-[#8B7CF6]/30 text-[#8B7CF6]">
                HIGH SECURITY
              </span>
            </div>
            <p class="text-text-muted text-xs sm:text-sm font-pixel leading-relaxed mb-4">
              Bulletproof, zero-raid community infrastructure with gamified engagement and custom bot automation.
            </p>
            <ul class="space-y-2 text-xs sm:text-sm font-pixel text-text-muted">
              <li class="flex items-center gap-2"><span class="text-[#8B7CF6] font-retro text-[9px]">▶</span> Anti-raid &amp; anti-nuke token security hardening</li>
              <li class="flex items-center gap-2"><span class="text-[#8B7CF6] font-retro text-[9px]">▶</span> Custom Discord bot development (XP, alerts, mini-games)</li>
              <li class="flex items-center gap-2"><span class="text-[#8B7CF6] font-retro text-[9px]">▶</span> VIP / Member role onboarding &amp; Twitch/YT sync</li>
              <li class="flex items-center gap-2"><span class="text-[#8B7CF6] font-retro text-[9px]">▶</span> Automated ticketing &amp; community moderator systems</li>
            </ul>
          </div>

          {/* Service 3 */}
          <div class="pixel-card rounded-xl p-6 sm:p-8 border-t-4 border-[#F4B860]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold font-retro text-text-main">
                Shorts &amp; Multi-Platform Scaling
              </h3>
              <span class="pixel-badge bg-[#F4B860]/15 border border-[#F4B860]/30 text-[#F4B860]">
                VIRAL FUNNELS
              </span>
            </div>
            <p class="text-text-muted text-xs sm:text-sm font-pixel leading-relaxed mb-4">
              Turn your long-form streams and videos into dozens of viral micro-clips that flood top-of-funnel discovery.
            </p>
            <ul class="space-y-2 text-xs sm:text-sm font-pixel text-text-muted">
              <li class="flex items-center gap-2"><span class="text-[#F4B860] font-retro text-[9px]">▶</span> Fast-paced clip extraction &amp; animated pixel captions</li>
              <li class="flex items-center gap-2"><span class="text-[#F4B860] font-retro text-[9px]">▶</span> Daily automated posting across YouTube Shorts &amp; TikTok</li>
              <li class="flex items-center gap-2"><span class="text-[#F4B860] font-retro text-[9px]">▶</span> Pinned comment conversion funnels to main channel</li>
              <li class="flex items-center gap-2"><span class="text-[#F4B860] font-retro text-[9px]">▶</span> Sound selection &amp; algorithmic trend capitalization</li>
            </ul>
          </div>

          {/* Service 4 */}
          <div class="pixel-card rounded-xl p-6 sm:p-8 border-t-4 border-[#4ADE80]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold font-retro text-text-main">
                Creator Monetization &amp; Agency
              </h3>
              <span class="pixel-badge bg-[#4ADE80]/15 border border-[#4ADE80]/30 text-[#4ADE80]">
                REVENUE MAX
              </span>
            </div>
            <p class="text-text-muted text-xs sm:text-sm font-pixel leading-relaxed mb-4">
              Maximize CPMs, secure recurring sponsor partnerships, and engineer high-margin creator merchandise &amp; VIP tiers.
            </p>
            <ul class="space-y-2 text-xs sm:text-sm font-pixel text-text-muted">
              <li class="flex items-center gap-2"><span class="text-[#4ADE80] font-retro text-[9px]">▶</span> Inbound brand sponsor pitch deck &amp; rate card creation</li>
              <li class="flex items-center gap-2"><span class="text-[#4ADE80] font-retro text-[9px]">▶</span> Sponsor read script optimization &amp; integration</li>
              <li class="flex items-center gap-2"><span class="text-[#4ADE80] font-retro text-[9px]">▶</span> Patreon / YouTube Membership / Discord VIP perks setup</li>
              <li class="flex items-center gap-2"><span class="text-[#4ADE80] font-retro text-[9px]">▶</span> Monthly analytics &amp; revenue performance reporting</li>
            </ul>
          </div>
        </div>
      </section>

      {/* Growth Calculator Section */}
      <section class="py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <GrowthCalculator client:visible />
      </section>

      <SectionDivider color="#F4B860" />

      {/* Testimonials preview */}
      <Testimonials client:visible data={content.testimonials} />

      {/* CTA */}
      <section class="py-16 px-4 sm:px-6 max-w-4xl mx-auto w-full text-center">
        <div class="pixel-card rounded-2xl p-8 sm:p-12 border border-accent/40 bg-accent/5">
          <h2 class="text-2xl sm:text-3xl font-bold font-retro text-text-main mb-4">
            Need A Custom Creator Scope?
          </h2>
          <p class="text-text-muted text-sm sm:text-base max-w-lg mx-auto font-pixel mb-6">
            Let's structure a tailored channel management and community agreement that fits your exact workflow.
          </p>
          <a
            href="/contact"
            class="pixel-btn pixel-btn-accent text-xs sm:text-sm py-3.5 px-8 rounded inline-flex items-center gap-2"
          >
            Request Custom Scope &amp; Pricing →
          </a>
        </div>
      </section>
    </main>
    
    <Footer client:visible />
  </div>
</Layout>
