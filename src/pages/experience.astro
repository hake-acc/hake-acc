---
// src/pages/experience.astro — Real Case Studies & Operations Metrics
import HakeLayout from "@/layouts/HakeLayout.astro";
---

<HakeLayout
  title="Experience & Case Studies — hake."
  description="Real case studies and operations breakdowns from Discord server restructuring, community retention systems, and creator workflow pipelines."
  activePage="experience"
>
  <!-- Subpage Header -->
  <header class="subpage-header-section">
    <span class="subpage-eyebrow">PROVEN TRACK RECORD</span>
    <h1 class="subpage-title">
      Case Studies &amp; Community Operations
    </h1>
    <p class="subpage-subtitle">
      Explore real operational breakdowns. Measurable results across Discord server overhauls, video editing pipeline management, and creator sponsor coordination.
    </p>

    <div class="subpage-stat-row">
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>4 Documented Case Studies</span>
      </div>
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>+45% Community Chat Lift</span>
      </div>
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>24h Editor Turnarounds</span>
      </div>
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>Zero Raid Incidents</span>
      </div>
    </div>
  </header>

  <!-- Main Content Flow -->
  <div class="subpage-content-wrap">

    <!-- Case Studies List -->
    <section class="case-studies-list" aria-label="Detailed Case Studies">
      
      <!-- Case 1: CappuMCXD -->
      <article class="case-study-item-card">
        <div>
          <span class="case-study-meta-tag">CASE STUDY 01 / DISCORD ARCHITECTURE</span>
          <h2 class="case-study-title">Restructuring CappuMCXD's 18,000-Member Discord Server</h2>
          
          <p class="case-study-paragraph">
            <strong>The Challenge:</strong> Rapid channel growth led to a chaotic server with over 50 unorganized channels, frequent phishing and raid attempts, slow moderation response times, and member fatigue in public chats.
          </p>

          <p class="case-study-paragraph">
            <strong>The Execution:</strong> We completely rebuilt the server hierarchy from the ground up. Streamlined 50+ channels into 8 intuitive categories, established custom AutoMod rules to block malicious links and spam, configured a private ticket support desk with automatic HTML transcript saving, and introduced VIP supporter roles for active Minecraft fans.
          </p>

          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <span class="service-tech-pill">Category Architecture</span>
            <span class="service-tech-pill">AutoMod Shield</span>
            <span class="service-tech-pill">Ticket Tool System</span>
            <span class="service-tech-pill">VIP Role Hierarchy</span>
          </div>
        </div>

        <div class="case-study-results-box">
          <div class="results-metric-group">
            <span class="results-number">+45%</span>
            <span class="results-label">Increase in weekly active chatters across core gaming channels</span>
          </div>
          <div class="results-metric-group">
            <span class="results-number">0 Raids</span>
            <span class="results-label">Zero spam raid outbreaks since permission matrix hardening</span>
          </div>
          <div class="results-metric-group">
            <span class="results-number">&lt; 15 min</span>
            <span class="results-label">Average ticket resolution speed by trained staff moderators</span>
          </div>
        </div>
      </article>

      <!-- Case 2: Arpan GamzO -->
      <article class="case-study-item-card">
        <div>
          <span class="case-study-meta-tag">CASE STUDY 02 / BOT AUTOMATION &amp; ALERTS</span>
          <h2 class="case-study-title">Sub-Second Video Alert Pipeline For Arpan GamzO</h2>
          
          <p class="case-study-paragraph">
            <strong>The Challenge:</strong> Due to YouTube notification delays and shadow-suppressed bell alerts, community members were routinely missing new video drops and live stream announcements, hurting initial 2-hour video velocity.
          </p>

          <p class="case-study-paragraph">
            <strong>The Execution:</strong> Developed a dedicated webhook alert bridge that pushes sub-second video embeds directly to the creator's 8,500-member community. Paired this with self-assignable alert roles so members can opt-in without annoying everyone, plus automated level perks that reward active chatters.
          </p>

          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <span class="service-tech-pill">Custom Webhooks</span>
            <span class="service-tech-pill">Stream Alerts</span>
            <span class="service-tech-pill">Opt-in Roles</span>
            <span class="service-tech-pill">Velocity Boosting</span>
          </div>
        </div>

        <div class="case-study-results-box">
          <div class="results-metric-group">
            <span class="results-number">100%</span>
            <span class="results-label">Alert reliability across 50+ consecutive video uploads</span>
          </div>
          <div class="results-metric-group">
            <span class="results-number">3.2x</span>
            <span class="results-label">First-hour viewer arrival from Discord community alerts</span>
          </div>
          <div class="results-metric-group">
            <span class="results-number">2,000+</span>
            <span class="results-label">Opted-in community members with custom notification roles</span>
          </div>
        </div>
      </article>

      <!-- Case 3: Video Production Pipeline -->
      <article class="case-study-item-card">
        <div>
          <span class="case-study-meta-tag">CASE STUDY 03 / CREATOR PRODUCTION PIPELINES</span>
          <h2 class="case-study-title">Optimizing Editing Pipelines &amp; Thumbnail Packaging</h2>
          
          <p class="case-study-paragraph">
            <strong>The Challenge:</strong> Gaming creators often lose days communicating back-and-forth with freelance video editors. Conflicting notes, disorganized footage drives, and rushed thumbnail designs led to missed upload schedules and inconsistent video pacing.
          </p>

          <p class="case-study-paragraph">
            <strong>The Execution:</strong> Implemented a centralized Notion and Trello production pipeline connecting creators, video editors, and thumbnail artists. Standardized footage handoffs, conducted first-30-second hook retention reviews, and tested high-contrast thumbnail variants tailored for mobile click-through rates.
          </p>

          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <span class="service-tech-pill">Production Notion CRM</span>
            <span class="service-tech-pill">Retention Auditing</span>
            <span class="service-tech-pill">Thumbnail Pacing</span>
            <span class="service-tech-pill">Editor Management</span>
          </div>
        </div>

        <div class="case-study-results-box">
          <div class="results-metric-group">
            <span class="results-number">24 Hours</span>
            <span class="results-label">Average turnaround on final cut revisions (down from 5 days)</span>
          </div>
          <div class="results-metric-group">
            <span class="results-number">+2.4%</span>
            <span class="results-label">Average CTR improvement across optimized thumbnail variants</span>
          </div>
          <div class="results-metric-group">
            <span class="results-number">0 Delays</span>
            <span class="results-label">Zero missed upload deadlines across consecutive scheduled weeks</span>
          </div>
        </div>
      </article>

      <!-- Case 4: Alex Adi XD Sponsor Vetting -->
      <article class="case-study-item-card">
        <div>
          <span class="case-study-meta-tag">CASE STUDY 04 / BRAND DEALS &amp; REVENUE</span>
          <h2 class="case-study-title">Sponsor Vetting &amp; Deliverable Management for Alex Adi XD</h2>
          
          <p class="case-study-paragraph">
            <strong>The Challenge:</strong> Fast-growing creators receive dozens of daily business inquiries, but over 80% are malicious scams, malware downloads, or exploitative low-ball offers that waste creator time.
          </p>

          <p class="case-study-paragraph">
            <strong>The Execution:</strong> Established a screened business inbox workflow. Formatted a professional media kit showcasing accurate viewer demographics, negotiated fair flat-rate pricing for integrated segments, tracked contract timestamps, and ensured all sponsor links and tracking codes were verified before video upload.
          </p>

          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <span class="service-tech-pill">Inbox Screening</span>
            <span class="service-tech-pill">Media Kit Formulation</span>
            <span class="service-tech-pill">Rate Negotiation</span>
            <span class="service-tech-pill">Deliverable Proof</span>
          </div>
        </div>

        <div class="case-study-results-box">
          <div class="results-metric-group">
            <span class="results-number">100%</span>
            <span class="results-label">Malicious sponsor scams filtered before reaching creator</span>
          </div>
          <div class="results-metric-group">
            <span class="results-number">100%</span>
            <span class="results-label">Contract deliverable compliance and on-time brand payouts</span>
          </div>
          <div class="results-metric-group">
            <span class="results-number">4+ Deals</span>
            <span class="results-label">Multi-video recurring sponsor relationships maintained</span>
          </div>
        </div>
      </article>

    </section>

    <!-- Bottom CTA Card -->
    <section style="background: linear-gradient(135deg, var(--card-elevated) 0%, var(--card-bg) 100%); border: 1px solid var(--border-line); border-radius: 24px; padding: 48px; text-align: center; box-shadow: var(--shadow-card);">
      <h2 style="font-family: var(--font-heading); font-size: clamp(24px, 3vw, 36px); font-weight: 800; color: var(--text-main); margin-bottom: 12px;">
        Ready For Similar Operational Results?
      </h2>
      <p style="font-size: 15px; color: var(--text-muted); max-width: 580px; margin: 0 auto 28px; line-height: 1.6;">
        Let's discuss your current server bottlenecks or creator workflow needs. Direct communication, honest expectations, and proven systems.
      </p>
      <a href="/contact" class="btn-primary-action" style="font-size: 16px; padding: 14px 36px;">
        <span>Let's Work Together &rarr;</span>
      </a>
    </section>

  </div>
</HakeLayout>
