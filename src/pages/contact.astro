---
// src/pages/contact.astro - Direct Inquiries & Contact Hub
import HakeLayout from "@/layouts/HakeLayout.astro";
---

<HakeLayout
  title="Contact & Direct Inquiries | hake."
  description="Reach out directly to Hake for Discord server architecture, bot automation, and creator operations coordination."
  activePage="contact"
>
  <!-- Subpage Header -->
  <header class="subpage-header-section">
    <!-- Right-side Animated Paper Plane with Directional Hero Flight Trail -->
    <div class="contact-plane-ornament subpage-plane-ornament" aria-hidden="true">
      <div class="plane-flight-stage">
        <!-- Directional Hero Flight Trail & Pure Vector Paper Plane (Infinitely Crisp on Retina/4K) -->
        <svg class="flight-trail-system" viewBox="0 0 170 85" fill="none">
          <defs>
            <linearGradient id="flightTrailLight" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#0055EE" stop-opacity="0.15" />
              <stop offset="50%" stop-color="#0055EE" stop-opacity="0.65" />
              <stop offset="100%" stop-color="#2563EB" stop-opacity="0.95" />
            </linearGradient>
            <linearGradient id="flightTrailDark" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.2" />
              <stop offset="50%" stop-color="#38BDF8" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#BAE6FD" stop-opacity="1" />
            </linearGradient>
            <linearGradient id="planeWingLightSub" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFFFFF" />
              <stop offset="70%" stop-color="#FFFFFF" />
              <stop offset="100%" stop-color="#E0F2FE" />
            </linearGradient>
            <filter id="flightTrailGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="1.5" result="blur" />
              <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
          </defs>

          <!-- Atmospheric Path Aura in Dark Mode -->
          <path class="flight-trail-aura" d="M 14 76 C 36 78, 56 68, 62 48 C 68 28, 48 18, 32 26 C 18 34, 22 58, 44 68 C 68 78, 88 61, 101 50" stroke="url(#flightTrailLight)" stroke-width="4" stroke-linecap="round" opacity="0" filter="url(#flightTrailGlow)" />

          <!-- Single Directional Dashed Trajectory (emerges directly from plane tail at 101, 50) -->
          <path class="flight-trail-dash" d="M 14 76 C 36 78, 56 68, 62 48 C 68 28, 48 18, 32 26 C 18 34, 22 58, 44 68 C 68 78, 88 61, 101 50" stroke="url(#flightTrailLight)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 8" />

          <!-- Clean Vector Paper Plane (pixel-matched from original hero reference) -->
          <g class="plane-vector-glider" transform="translate(83, -3)">
            <!-- Facet 1: Top Wing (Crisp White) -->
            <polygon points="2,19 78,4 17,31" fill="#FFFFFF" stroke="none" />
            <!-- Facet 2: Bottom Wing (Crisp White) -->
            <polygon points="78,4 45,63 26.5,40" fill="#FFFFFF" stroke="none" />
            <!-- Facet 3: Central Crease Stripe (Soft Sky Blue Shading) -->
            <polygon points="17,31 78,4 26.5,40" fill="#BAE6FD" stroke="none" />
            <!-- Facet 4: Keel / Under-Fold (Sky Blue Shading) -->
            <polygon points="17,31 18,53 26.5,40" fill="#BAE6FD" stroke="none" />
            <!-- Outlines & Creases -->
            <path d="M 2,19 L 78,4 L 45,63 L 26.5,40 L 18,53 L 17,31 Z M 17,31 L 78,4 M 26.5,40 L 78,4 M 17,31 L 26.5,40"
              stroke="#0B132B" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" fill="none" />
          </g>

        </svg>
      </div>
    </div>

    <span class="subpage-eyebrow">GET IN TOUCH</span>
    <h1 class="subpage-title">
      Let's Build Something Great Together
    </h1>
    <p class="subpage-subtitle">
      Have a Discord server that needs restructuring, or looking for reliable operations management for your channel? Reach out directly through any channel below.
    </p>

    <div class="subpage-stat-row">
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>Fastest Reply on Discord: <strong>hake_acc</strong></span>
      </div>
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>Average Response Time &lt; 2 Hours</span>
      </div>
      <div class="subpage-stat-pill">
        <span class="stat-dot"></span>
        <span>No Long-Term Contracts Required</span>
      </div>
    </div>
  </header>

  <!-- Main Content Flow -->
  <div class="subpage-content-wrap">

    <!-- Contact Methods & Form Grid -->
    <section class="contact-grid-container" style="margin-bottom: 64px;">
      
      <!-- Left: Direct Social Links -->
      <div class="contact-methods-card">
        <h2 class="contact-card-title">Direct Channels</h2>
        <p class="contact-card-sub">Fastest response is on Discord or Twitter/X.</p>

        <div class="social-links-list">
          <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="social-contact-item">
            <span class="social-item-icon discord-icon-bg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </span>
            <div class="social-item-meta">
              <span class="social-label">Discord DM</span>
              <strong class="social-value">hake_acc</strong>
            </div>
            <span class="social-action-arrow">&rarr;</span>
          </a>

          <a href="https://twitter.com/hake_acc" target="_blank" rel="noopener noreferrer" class="social-contact-item">
            <span class="social-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </span>
            <div class="social-item-meta">
              <span class="social-label">Twitter / X</span>
              <strong class="social-value">@hake_acc</strong>
            </div>
            <span class="social-action-arrow">&rarr;</span>
          </a>

          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-contact-item">
            <span class="social-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </span>
            <div class="social-item-meta">
              <span class="social-label">YouTube</span>
              <strong class="social-value">Creator Network</strong>
            </div>
            <span class="social-action-arrow">&rarr;</span>
          </a>

          <a href="mailto:contact@hakeacc.com" class="social-contact-item">
            <span class="social-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <div class="social-item-meta">
              <span class="social-label">Email</span>
              <strong class="social-value">contact@hakeacc.com</strong>
            </div>
            <span class="social-action-arrow">&rarr;</span>
          </a>
        </div>

        <div style="margin-top: 24px; padding: 18px; background-color: var(--card-elevated); border: 1px solid var(--border-line); border-radius: 12px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <strong style="font-size: 13px; color: var(--text-main);">Current Availability:</strong>
          </div>
          <p style="font-size: 12.5px; color: var(--text-muted); line-height: 1.5;">
            Accepting select creator server overhauls and monthly operations retainers for active gaming channels.
          </p>
        </div>
      </div>

      <!-- Right: Working Inquiry Form -->
      <div class="contact-form-card">
        <h2 class="contact-card-title">Send An Inquiry</h2>
        <p class="contact-card-sub">Let me know what you need help with and I'll get back to you promptly.</p>

        <form class="inquiry-form" id="contactInquiryForm" onsubmit="handleSubpageInquirySubmit(event)">
          <div class="form-field-group">
            <label for="inputName" class="form-label">Your Name or Channel</label>
            <input type="text" id="inputName" name="name" required placeholder="e.g. Alex / Alex Adi XD" class="form-input" />
          </div>

          <div class="form-field-group">
            <label for="inputDiscord" class="form-label">Discord Username or Server Invite</label>
            <input type="text" id="inputDiscord" name="discord" required placeholder="e.g. username or discord.gg/..." class="form-input" />
          </div>

          <div class="form-field-group">
            <label for="inputEmail" class="form-label">Email Address</label>
            <input type="email" id="inputEmail" name="email" required placeholder="e.g. alex@example.com" class="form-input" />
          </div>

          <div class="form-field-group">
            <label for="selectService" class="form-label">Service Needed</label>
            <select id="selectService" name="service" class="form-select">
              <option value="Discord Server Overhaul">Discord Server Overhaul (One-Time)</option>
              <option value="Monthly Community Ops">Monthly Community Ops Retainer</option>
              <option value="Bot Automation Setup">Automated Bot &amp; AutoMod Setup</option>
              <option value="Video Editing Pipeline">Video Editing Pipeline Coordination</option>
              <option value="Sponsorship Management">Sponsorship &amp; Brand Deal Management</option>
              <option value="Full Creator Suite">Complete Creator Operations Suite</option>
            </select>
          </div>

          <div class="form-field-group">
            <label for="inputMessage" class="form-label">Project Details</label>
            <textarea id="inputMessage" name="message" rows="4" required placeholder="Describe your current community size, what is feeling disorganized or broken, and your target timeline..." class="form-textarea"></textarea>
          </div>

          <button type="submit" class="btn-submit-inquiry" id="submitBtn">
            <span>Send Inquiry</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
          
          <div class="form-feedback-msg" id="contactFeedbackMsg" style="display: none;"></div>
        </form>
      </div>

    </section>

    <!-- FAQ Accordion Section -->
    <section class="faq-section-wrap" aria-label="Frequently Asked Questions">
      <div style="text-align: center;">
        <span class="subpage-eyebrow">COMMON QUESTIONS</span>
        <h2 style="font-family: var(--font-heading); font-size: 28px; font-weight: 800; color: var(--text-main); margin-bottom: 8px;">
          Frequently Asked Questions
        </h2>
        <p style="font-size: 14.5px; color: var(--text-muted);">
          Honest answers about how overhauls work, turnaround times, and ongoing operations.
        </p>
      </div>

      <div class="faq-list">
        
        <div class="faq-item-card">
          <h3 class="faq-q">How long does a full server restructure take?</h3>
          <p class="faq-a">
            Typically 3 to 7 business days from initial audit to final launch, depending on the number of members, bot integrations, and custom embed requirements. We do the setup without taking your server offline.
          </p>
        </div>

        <div class="faq-item-card">
          <h3 class="faq-q">Do you need full administrator permissions?</h3>
          <p class="faq-a">
            Yes, temporarily during the build and configuration phase so roles, webhooks, and channel permissions can be structured cleanly. Once everything is tested and handed off, permissions can be locked down. Server ownership always remains 100% with the creator.
          </p>
        </div>

        <div class="faq-item-card">
          <h3 class="faq-q">What bots do you typically install?</h3>
          <p class="faq-a">
            I prioritize lightweight, reliable bots that don't lag or go offline: Discord's native AutoMod, Sapphire, Ticket Tool, and Carl-bot for reaction tags. For stream alerts, I use custom webhooks that push sub-second notifications.
          </p>
        </div>

        <div class="faq-item-card">
          <h3 class="faq-q">Can you work with our existing video editors and staff?</h3>
          <p class="faq-a">
            Yes. I don't replace your creative team; I coordinate with them. I set up streamlined Notion or Trello pipelines so footage handoffs, revision notes, and upload deadlines are tracked without constant back-and-forth messaging.
          </p>
        </div>

        <div class="faq-item-card">
          <h3 class="faq-q">How does ongoing monthly retainer management work?</h3>
          <p class="faq-a">
            Retainers are billed month-to-month with no long-term lock-in. You get direct priority access on Discord, ongoing moderation oversight, bot maintenance, upload notification pings, and weekly chat health reports.
          </p>
        </div>

      </div>
    </section>

  </div>

  <script is:inline>
    function handleSubpageInquirySubmit(e) {
      e.preventDefault();
      const form = document.getElementById('contactInquiryForm');
      const btn = document.getElementById('submitBtn');
      const feedback = document.getElementById('contactFeedbackMsg');

      const name = document.getElementById('inputName').value.trim();
      const discord = document.getElementById('inputDiscord').value.trim();
      const email = document.getElementById('inputEmail').value.trim();
      const service = document.getElementById('selectService').value;
      const message = document.getElementById('inputMessage').value.trim();

      if (!name || !discord || !email || !message) return;

      btn.disabled = true;
      btn.innerHTML = '<span>Preparing Inquiry...</span>';

      const subject = encodeURIComponent(`Project Inquiry: ${service} - ${name}`);
      const body = encodeURIComponent(
        `Hi Hake,\n\nName / Channel: ${name}\nDiscord Tag: ${discord}\nEmail: ${email}\nService Needed: ${service}\n\nProject Details:\n${message}\n\nLooking forward to hearing from you!`
      );

      feedback.style.display = 'block';
      feedback.style.color = 'var(--accent-blue)';
      feedback.style.backgroundColor = 'rgba(0, 102, 255, 0.08)';
      feedback.style.border = '1px solid rgba(0, 102, 255, 0.2)';
      feedback.innerHTML = 'Opening your email client to send inquiry directly... (or message <strong>hake_acc</strong> on Discord)';

      setTimeout(() => {
        window.location.href = `mailto:contact@hakeacc.com?subject=${subject}&body=${body}`;
        btn.disabled = false;
        btn.innerHTML = '<span>Send Inquiry</span>';
      }, 600);
    }
  </script>
</HakeLayout>
