---
import Layout from "@/layouts/Layout.astro";
import content from "@/data/content.json";
import Sidebar from "@/components/Sidebar";
import Navigation from "@/components/Navigation";
import About from "@/components/About";
import TerminalSimulator from "@/components/TerminalSimulator";
import Footer from "@/components/Footer";
import SectionDivider from "@/components/SectionDivider";
---

<Layout
  title="About Hake Acc — Social Media Manager & Agency Founder"
  description="Learn more about Hake Acc, creator growth strategist, Discord architect, and founder of Hake Acc Agency."
>
  <Sidebar client:load />
  <div class="lg:pl-[220px] flex flex-col min-h-screen">
    <Navigation client:load />
    
    <main id="main-content" class="flex-1 pt-20">
      {/* Page Header */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-accent/15 border border-accent/30 rounded text-accent font-silkscreen text-xs mb-4">
          <span class="w-2 h-2 rounded-sm bg-accent" />
          <span>ABOUT THE FOUNDER</span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-retro text-text-main leading-tight mb-4">
          Engineering The Future Of
          <br />
          <span class="gradient-text">Creator Communities.</span>
        </h1>
        <p class="text-text-muted text-sm sm:text-base md:text-lg max-w-2xl mx-auto font-pixel leading-relaxed">
          From viral video packaging and high-security Discord bot ecosystems to end-to-end creator talent management.
        </p>
      </section>

      <About client:load data={content.about} />
      
      <SectionDivider color="#8B7CF6" />

      {/* Core Philosophy Section */}
      <section class="py-16 sm:py-20 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <div class="text-center mb-12">
          <p class="section-label mb-2">// GROWTH PRINCIPLES</p>
          <h2 class="text-3xl sm:text-4xl font-bold font-retro text-text-main">
            The Hake Acc Agency Philosophy
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="pixel-card rounded-xl p-6 sm:p-7 border-t-4 border-[#6AA9FF]">
            <div class="text-2xl font-bold font-retro text-[#6AA9FF] mb-3">01</div>
            <h3 class="text-lg font-bold font-retro text-text-main mb-2">High-Retention Packaging</h3>
            <p className="text-text-muted text-xs sm:text-sm font-pixel leading-relaxed">
              Great content fails without magnetic packaging. We test dozens of title hooks, custom thumbnail variants, and initial 30-second pacing to guarantee peak CTR and watch time.
            </p>
          </div>

          <div class="pixel-card rounded-xl p-6 sm:p-7 border-t-4 border-[#8B7CF6]">
            <div class="text-2xl font-bold font-retro text-[#8B7CF6] mb-3">02</div>
            <h3 class="text-lg font-bold font-retro text-text-main mb-2">Superfan Architecture</h3>
            <p className="text-text-muted text-xs sm:text-sm font-pixel leading-relaxed">
              Viewers are temporary, but community members are lifelong. We turn passive video viewers into dedicated Discord superfans with custom economy bots, VIP tiers, and interactive events.
            </p>
          </div>

          <div class="pixel-card rounded-xl p-6 sm:p-7 border-t-4 border-[#F4B860]">
            <div class="text-2xl font-bold font-retro text-[#F4B860] mb-3">03</div>
            <h3 class="text-lg font-bold font-retro text-text-main mb-2">Compounding Creator Equity</h3>
            <p className="text-text-muted text-xs sm:text-sm font-pixel leading-relaxed">
              We build systems that don't rely solely on the algorithm. Through cross-platform shorts funnels, email captures, and multi-tier monetization, your brand builds lasting equity.
            </p>
          </div>
        </div>
      </section>

      {/* Interactive Terminal Sandbox */}
      <section class="py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <div class="text-center mb-6">
          <p class="section-label mb-2">// COMMAND TERMINAL</p>
          <h2 class="text-2xl sm:text-3xl font-bold font-retro text-text-main">
            Run Bot Commands &amp; Explore Blueprints
          </h2>
        </div>
        <TerminalSimulator client:visible />
      </section>

      {/* FAQ Accordion */}
      <section class="py-16 sm:py-20 px-4 sm:px-6 max-w-5xl mx-auto w-full">
        <div class="text-center mb-12">
          <p class="section-label mb-2">// FAQ</p>
          <h2 class="text-3xl sm:text-4xl font-bold font-retro text-text-main">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-4">
          {[
            {
              q: "What size channels do you manage?",
              a: "We work primarily with creators ranging from 100K to 5M+ subscribers, as well as high-growth emerging creators who are ready to scale their production and community backend.",
            },
            {
              q: "How does Discord server security and anti-raid protection work?",
              a: "We deploy custom hardened verification bots, captcha gating, automated anti-nuke permissions, webhook monitoring, and role hierarchies that make servers immune to raids and unauthorized token attacks.",
            },
            {
              q: "What is your onboarding process for new channels?",
              a: "We begin with a comprehensive 14-day channel & audience audit, followed by thumbnail A/B infrastructure setup, upload schedule alignment, and Discord bot integration.",
            },
            {
              q: "Do you handle sponsorships and brand deals?",
              a: "Yes. Our agency team assists in sponsor read integration, rate card negotiations, contract reviews, and brand delivery reports.",
            },
          ].map((item, idx) => (
            <div key={idx} class="pixel-card rounded-xl p-5 sm:p-6 border border-white/10">
              <h3 class="text-base sm:text-lg font-bold font-retro text-accent mb-2">
                Q: {item.q}
              </h3>
              <p class="text-text-muted text-xs sm:text-sm font-pixel leading-relaxed">
                {item.a}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* CTA */}
      <section class="py-16 px-4 sm:px-6 max-w-4xl mx-auto w-full text-center">
        <div class="pixel-card rounded-2xl p-8 sm:p-12 border border-accent/40 bg-accent/5">
          <h2 class="text-2xl sm:text-3xl font-bold font-retro text-text-main mb-4">
            Ready To Upgrade Your Channel Operations?
          </h2>
          <p class="text-text-muted text-sm sm:text-base max-w-lg mx-auto font-pixel mb-6">
            Let's discuss how Hake Acc Agency can scale your views, retention, and community.
          </p>
          <a
            href="/contact"
            class="pixel-btn pixel-btn-accent text-xs sm:text-sm py-3.5 px-8 rounded inline-flex items-center gap-2"
          >
            Schedule A Strategy Call →
          </a>
        </div>
      </section>
    </main>
    
    <Footer client:visible />
  </div>
</Layout>
