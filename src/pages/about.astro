---
import Layout from "@/layouts/Layout.astro";
import content from "@/data/content.json";
import Sidebar from "@/components/Sidebar";
import Navigation from "@/components/Navigation";
import About from "@/components/About";
import TerminalSimulator from "@/components/TerminalSimulator";
import Footer from "@/components/Footer";
import SectionDivider from "@/components/SectionDivider";
import PageNav from "@/components/PageNav";
---

<Layout
  title="About Hake Acc — Content Strategist & Agency Founder"
  description="Learn more about Hake Acc, creator growth strategist, Discord architect, and founder of Hake Acc Agency."
>
  <Sidebar client:media="(min-width: 1024px)" />
  <div class="lg:pl-[220px] flex flex-col min-h-screen">
    <Navigation client:idle />
    
    <main id="main-content" class="flex-1 pt-16 lg:pt-0">
      {/* Page Header */}
      <section class="py-12 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto w-full text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber/15 border border-amber/30 rounded text-amber font-silkscreen text-xs mb-4">
          <span class="w-2 h-2 rounded-sm bg-amber" />
          <span>ABOUT THE FOUNDER</span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-retro text-text-main leading-tight mb-4">
          Engineering The Future Of
          <br />
          <span class="gradient-text">Creator Communities.</span>
        </h1>
        <p class="text-text-muted text-sm sm:text-base md:text-lg max-w-2xl mx-auto font-readable leading-relaxed">
          From viral video packaging and high-security Discord bot ecosystems to end-to-end creator talent management.
        </p>
      </section>

      <About client:load data={content.about} />
      
      <SectionDivider color="#818cf8" />

      {/* Core Philosophy Section */}
      <section class="py-16 sm:py-20 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <div class="text-center mb-12">
          <p class="section-label mb-2">// GROWTH PRINCIPLES</p>
          <h2 class="text-3xl sm:text-4xl font-bold font-retro text-text-main">
            The Hake Acc Agency Philosophy
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-readable">
          <div class="pixel-hud-card rounded-xl p-6 sm:p-7 border-t-4 border-cyan bg-[#131622]">
            <div class="text-2xl font-bold font-retro text-cyan mb-3">01</div>
            <h3 class="text-lg font-bold font-retro text-text-main mb-2">High-Retention Packaging</h3>
            <p class="text-text-muted text-xs sm:text-sm leading-relaxed">
              Great content fails without magnetic packaging. We test dozens of title hooks, custom thumbnail variants, and initial 30-second pacing to guarantee peak CTR and watch time.
            </p>
          </div>

          <div class="pixel-hud-card rounded-xl p-6 sm:p-7 border-t-4 border-purple bg-[#131622]">
            <div class="text-2xl font-bold font-retro text-purple mb-3">02</div>
            <h3 class="text-lg font-bold font-retro text-text-main mb-2">Superfan Architecture</h3>
            <p class="text-text-muted text-xs sm:text-sm leading-relaxed">
              Viewers are temporary, but community members are lifelong. We turn passive video viewers into dedicated Discord superfans with custom economy bots, VIP tiers, and interactive events.
            </p>
          </div>

          <div class="pixel-hud-card rounded-xl p-6 sm:p-7 border-t-4 border-amber bg-[#131622]">
            <div class="text-2xl font-bold font-retro text-amber mb-3">03</div>
            <h3 class="text-lg font-bold font-retro text-text-main mb-2">Compounding Creator Equity</h3>
            <p class="text-text-muted text-xs sm:text-sm leading-relaxed">
              We don&apos;t just optimize single video uploads — we build sustainable creator infrastructure that generates recurring brand deals, higher sponsorship rates, and passive member conversions.
            </p>
          </div>
        </div>
      </section>

      <SectionDivider color="#38bdf8" />

      {/* Interactive Terminal Sandbox */}
      <section class="py-16 sm:py-20 px-4 sm:px-6 max-w-7xl mx-auto w-full">
        <div class="text-center mb-8">
          <p class="section-label mb-2">// COMMAND INTERFACE</p>
          <h2 class="text-3xl sm:text-4xl font-bold font-retro text-text-main">
            Interact With The Bot
          </h2>
        </div>
        <TerminalSimulator client:visible />
      </section>

      <SectionDivider color="#f59e0b" />

      {/* FAQ Accordion in Accessible Typography */}
      <section class="py-16 sm:py-20 px-4 sm:px-6 max-w-4xl mx-auto w-full font-readable">
        <div class="text-center mb-12">
          <p class="section-label mb-2">// FREQUENTLY ASKED QUESTIONS</p>
          <h2 class="text-3xl sm:text-4xl font-bold font-retro text-text-main">
            How We Work With Creators
          </h2>
        </div>

        <div class="space-y-4">
          {[
            {
              q: "What types of YouTube channels do you work with?",
              a: "We specialize in gaming, variety, Minecraft, entertainment, commentary, and creator network brands. We typically work with creators looking to scale from 50K+ subscribers into the millions."
            },
            {
              q: "Do you handle complete video production or just packaging?",
              a: "We provide end-to-end management: title hook strategy, custom thumbnail art direction, upload scheduling, video SEO metadata, Shorts repurposing, and Discord community management."
            },
            {
              q: "How fast can you set up a high-security Discord server?",
              a: "Standard custom Discord server setups with anti-raid security, custom role hierarchy, automated Twitch/YouTube alerts, and onboarding flows are fully deployed within 3 to 5 business days."
            },
            {
              q: "What are your engagement terms?",
              a: "We offer both monthly retainer management contracts for active YouTubers and fixed-scope project agreements for Discord infrastructure builds and creator consulting."
            }
          ].map((faq) => (
            <div key={faq.q} class="pixel-hud-card rounded-xl p-6 bg-[#131622] border border-border hover:border-amber/40 transition-colors">
              <h3 class="text-base font-bold font-retro text-text-main mb-2">
                {faq.q}
              </h3>
              <p class="text-text-muted text-xs sm:text-sm leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* Page navigation */}
      <PageNav client:load prevHref="/" prevLabel="Home" nextHref="/projects" nextLabel="Explore Channels" />
    </main>
    
    <Footer client:visible />
  </div>
</Layout>
