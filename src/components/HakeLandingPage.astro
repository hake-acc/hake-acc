    <!-- Interactive Logic -->
    <script>
      // 1. Theme Toggle (Light & Discord Dark)
      const themeToggle = document.getElementById('themeToggle');
      const iconSun = themeToggle?.querySelector('.icon-sun') as HTMLElement | null;
      const iconMoon = themeToggle?.querySelector('.icon-moon') as HTMLElement | null;

      function updateThemeIcons(isDark: boolean) {
        if (iconSun && iconMoon) {
          iconSun.style.display = isDark ? 'block' : 'none';
          iconMoon.style.display = isDark ? 'none' : 'block';
        }
      }

      function setTheme(theme: 'light' | 'dark') {
        const isDark = theme === 'dark';
        document.body.className = isDark ? 'hake-theme-dark' : 'hake-theme-light';
        document.documentElement.classList.toggle('dark-theme', isDark);
        updateThemeIcons(isDark);
        try { localStorage.setItem('hake-theme', theme); } catch(e) {}
      }

      // Check initial theme
      const savedTheme = localStorage.getItem('hake-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      setTheme(savedTheme ? (savedTheme as 'light' | 'dark') : (prefersDark ? 'dark' : 'light'));

      themeToggle?.addEventListener('click', () => {
        const currentIsDark = document.body.classList.contains('hake-theme-dark');
        setTheme(currentIsDark ? 'light' : 'dark');
      });

      // 2. Smooth Left-to-Right SVG Underline Animation with Session Caching
      const togetherAccent = document.getElementById('heroTogetherAccent');
      if (togetherAccent) {
        const isCached = sessionStorage.getItem('hake_underline_cached');
        if (isCached === 'true') {
          togetherAccent.classList.add('underline-cached');
        } else {
          togetherAccent.classList.add('animating-underline');
          try { sessionStorage.setItem('hake_underline_cached', 'true'); } catch(e) {}
        }

        // Replay on click
        function replayUnderline() {
          if (!togetherAccent) return;
          togetherAccent.classList.remove('underline-cached', 'animating-underline');
          void togetherAccent.offsetWidth; // force DOM reflow
          togetherAccent.classList.add('animating-underline');
        }
        togetherAccent.addEventListener('click', replayUnderline);
        togetherAccent.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            replayUnderline();
          }
        });
      }

      // 3. Mobile Drawer Controls
      const mobileMenuToggle = document.getElementById('mobileMenuToggle');
      const quickbarMenuBtn = document.getElementById('quickbarMenuBtn');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const drawerOverlay = document.getElementById('drawerOverlay');
      const drawerCloseBtn = document.getElementById('drawerCloseBtn');

      function openDrawer() {
        mobileDrawer?.classList.add('open');
        drawerOverlay?.classList.add('open');
        mobileMenuToggle?.setAttribute('aria-expanded', 'true');
        mobileDrawer?.setAttribute('aria-hidden', 'false');
        drawerOverlay?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        mobileDrawer?.classList.remove('open');
        drawerOverlay?.classList.remove('open');
        mobileMenuToggle?.setAttribute('aria-expanded', 'false');
        mobileDrawer?.setAttribute('aria-hidden', 'true');
        drawerOverlay?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      mobileMenuToggle?.addEventListener('click', openDrawer);
      quickbarMenuBtn?.addEventListener('click', openDrawer);
      drawerCloseBtn?.addEventListener('click', closeDrawer);
      drawerOverlay?.addEventListener('click', closeDrawer);

      // Close drawer when clicking any link inside it
      document.querySelectorAll('.drawer-nav-item, #drawerCtaBtn').forEach(el => {
        el.addEventListener('click', closeDrawer);
      });

      // 4. Smooth In-page Navigation Highlighting
      const navLinks = document.querySelectorAll('.nav-links .nav-item');
      const sections = document.querySelectorAll('section[id]');
      window.addEventListener('scroll', () => {
        let current = '';
        const scrollPos = window.scrollY + 120;
        sections.forEach(section => {
          const top = (section as HTMLElement).offsetTop;
          const height = (section as HTMLElement).offsetHeight;
          if (scrollPos >= top && scrollPos < top + height) {
            current = section.getAttribute('id') || '';
          }
        });
        navLinks.forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('href') === `#${current}`) {
            link.classList.add('active');
          }
        });
      }, { passive: true });

      // 5. Inquiry Form Handler
      (window as any).handleInquirySubmit = function(event: Event) {
        event.preventDefault();
        const form = document.getElementById('inquiryForm') as HTMLFormElement;
        const feedback = document.getElementById('formFeedback');
        const submitBtn = document.getElementById('submitInquiryBtn');
        if (!form || !feedback) return;

        const formData = new FormData(form);
        const name = formData.get('name') as string;
        const discord = formData.get('discord') as string;
        const service = formData.get('service') as string;
        const message = formData.get('message') as string;

        const subject = encodeURIComponent(`Inquiry from ${name}: ${service}`);
        const body = encodeURIComponent(`Hi Hake,\n\nName: ${name}\nDiscord: ${discord}\nService: ${service}\n\nDetails:\n${message}`);

        feedback.style.display = 'block';
        feedback.className = 'form-feedback-msg success';
        feedback.innerHTML = `Opening mail client for <strong>${service}</strong>... You can also DM directly on Discord: <strong>hake_acc</strong>!`;

        setTimeout(() => {
          window.location.href = `mailto:contact@hakeacc.com?subject=${subject}&body=${body}`;
        }, 600);
      };
    </script>
