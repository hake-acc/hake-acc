  /* ====================================================
     FLOATING SOCIAL DOCK
     ==================================================== */
  .floating-dock {
    position: fixed;
    left: max(16px, calc((100vw - 1280px) / 2 - 68px));
    top: 50%;
    transform: translateY(-50%);
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transition: left 0.25s ease, opacity 0.25s ease;
  }

  .dock-capsule {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 8px;
    background-color: var(--dock-bg);
    border: 1px solid var(--border-line);
    border-radius: 20px;
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(12px);
  }

  .dock-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .dock-btn:hover {
    color: var(--accent-blue);
    background-color: var(--card-elevated);
    transform: scale(1.08);
  }

  .dock-status-dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent-green);
    border-radius: 50%;
    box-shadow: 0 1px 3px rgba(34, 197, 94, 0.4);
  }

  /* ====================================================
     HERO SECTION
     ==================================================== */
  .hake-hero-section {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    padding: 48px 48px 36px;
    gap: 24px;
    position: relative;
    z-index: 10;
    min-height: 600px;
  }

  .hero-left-content {
    max-width: 520px;
  }

  .hero-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-blue);
    margin-bottom: 20px;
    letter-spacing: 0.02em;
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent-blue);
    border-radius: 50%;
  }

  .hero-main-title {
    font-family: var(--font-heading);
    font-size: clamp(38px, 4.8vw, 62px);
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-main);
    letter-spacing: -0.035em;
    margin-bottom: 22px;
  }

  .hero-main-title span {
    display: block;
  }

  .hero-main-title .line-3 {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
  }

  /* Animated Left-to-Right Underline with Session Caching */
  .accent-container {
    position: relative;
    display: inline-block;
    color: var(--accent-blue);
    cursor: pointer;
    outline: none;
  }

  .brush-stroke {
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 100%;
    height: 24px;
    overflow: visible;
    pointer-events: none;
  }

  .brush-path-primary,
  .brush-path-secondary {
    stroke-dasharray: 230;
    stroke-dashoffset: 230;
    will-change: stroke-dashoffset;
  }

  /* First time entrance animation (smooth left-to-right draw) */
  .animating-underline .brush-path-primary {
    animation: drawStrokeLeftToRight 1.0s cubic-bezier(0.25, 1, 0.5, 1) 0.2s forwards;
  }

  .animating-underline .brush-path-secondary {
    animation: drawStrokeLeftToRightSecondary 0.9s cubic-bezier(0.25, 1, 0.5, 1) 0.28s forwards;
  }

  /* Cached in sessionStorage: already drawn */
  .underline-cached .brush-path-primary,
  .underline-cached .brush-path-secondary,
  .underline-cached-mode .brush-path-primary,
  .underline-cached-mode .brush-path-secondary {
    stroke-dashoffset: 0 !important;
    animation: none !important;
  }

  @keyframes drawStrokeLeftToRight {
    0% {
      stroke-dashoffset: 230;
      opacity: 0.2;
    }
    20% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes drawStrokeLeftToRightSecondary {
    0% {
      stroke-dashoffset: 230;
      opacity: 0.1;
    }
    30% {
      opacity: 0.7;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0.7;
    }
  }

  .hero-description {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 28px;
    max-width: 480px;
  }

  .hero-button-group {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 34px;
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    background: linear-gradient(180deg, #38BDF8 0%, #0284C7 32%, #0066FF 70%, #004BD6 100%);
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 
      0 1px 1px rgba(255, 255, 255, 0.5) inset,
      0 -2px 0 rgba(0, 30, 90, 0.35) inset,
      0 5px 16px rgba(0, 102, 255, 0.4),
      0 2px 4px rgba(0, 0, 0, 0.12);
    text-shadow: 0 1px 2px rgba(0, 20, 60, 0.4);
    font-family: var(--font-heading);
    font-size: 15px;
