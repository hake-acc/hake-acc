  /* Badges positioning matching exact reference:
     Left badges stacked cleanly outside character and above coffee mug/laptop (y <= 46%)
     Right badges stacked cleanly outside character, above desk and left of pencil (y <= 48%) */
  .badge-left-1 { left: -2%; top: 9%; }
  .badge-left-2 { left: -3%; top: 27%; }
  .badge-left-3 { left: -4%; top: 45%; }

