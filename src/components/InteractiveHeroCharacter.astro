---
// InteractiveHeroCharacter.astro
// Seamless 5-State Interactive Character Motion Engine for Hake
// 100% Character Consistency (Exact Hero Linework, Hair, and Palette)
// States:
// 1. Base Loop: Active typing with screen glow, breathing, eye blinks, coffee steam
// 2. Transition: Typing to Look up & wave
// 3. Greeting: Enthusiastic wave with interactive speech bubble
// 4. Listening: Attentive nod & listening wait with dialogue pills
// 5. Transition: Smooth return to laptop keys
---

<div 
  class="interactive-character-container hero-art-asset" 
  id="interactiveCharContainer"
  role="button"
  tabindex="0"
  aria-label="Interactive Hake character. Click to talk with Hake"
  title="Click to interact with Hake"
>
  <!-- Master Illustrated Pose Matrix (Hardware-accelerated, 100% consistent foundation) -->
  <div class="char-pose-stage" id="charPoseStage" aria-hidden="true">
    <img
      src="/assets/character_states/pose_typing.png"
      alt="Hake typing at laptop"
      class="char-pose-layer is-active"
      id="poseTyping"
      width="600"
      height="600"
      loading="eager"
      decoding="async"
    />
    <img
      src="/assets/character_states/pose_wave.png"
      alt="Hake waving hello"
      class="char-pose-layer is-hidden"
      id="poseWave"
      width="600"
      height="600"
      loading="eager"
      decoding="async"
    />
    <img
      src="/assets/character_states/pose_listen.png"
      alt="Hake listening attentively"
      class="char-pose-layer is-hidden"
      id="poseListen"
      width="600"
      height="600"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- 5-State Dedicated Preloaded Video Track Stage -->
  <div class="video-buffer-stage" id="videoBufferStage" aria-hidden="true">
    <!-- State 1: Base Typing Loop -->
    <video
      id="vidTyping"
      class="char-video-track is-active"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      src="/assets/character_states/clip_1_typing_loop.mp4"
    ></video>

    <!-- State 2: Transition Typing to Wave -->
    <video
      id="vidTransWave"
      class="char-video-track is-hidden"
      muted
      playsinline
      preload="metadata"
      src="/assets/character_states/clip_2_typing_to_wave.mp4"
    ></video>

    <!-- State 3: Waving Greeting -->
    <video
      id="vidWaving"
      class="char-video-track is-hidden"
      muted
      loop
      playsinline
      preload="metadata"
      src="/assets/character_states/clip_3_waving_speech.mp4"
    ></video>

    <!-- State 4: Listening Wait -->
    <video
      id="vidListening"
      class="char-video-track is-hidden"
      muted
      loop
      playsinline
      preload="metadata"
      src="/assets/character_states/clip_4_listening_wait.mp4"
    ></video>

    <!-- State 5: Transition Listening to Typing -->
    <video
      id="vidTransTyping"
      class="char-video-track is-hidden"
      muted
      playsinline
      preload="metadata"
      src="/assets/character_states/clip_5_listen_to_typing.mp4"
    ></video>
  </div>

  <!-- Interactive Speech Bubble (State 3 & 4) -->
  <div class="char-speech-bubble" id="charSpeechBubble" aria-live="polite" aria-hidden="true">
    <div class="speech-bubble-content">
      <div class="speech-bubble-avatar">
        <span class="speech-status-dot"></span>
        <span class="speech-name">hake.</span>
      </div>
      <p class="speech-text">
        Hey! I'm Hake. Wanna know what I can build for your community?
      </p>
      <div class="speech-actions">
        <a href="#services" class="speech-pill-btn" data-action="services">
          <span>Explore Services</span>
        </a>
        <a href="/experience" class="speech-pill-btn" data-action="cases">
          <span>Case Studies</span>
        </a>
        <button type="button" class="speech-pill-btn btn-dismiss" id="charDismissBtn" aria-label="Dismiss greeting and return to work">
          <span>Back to Work</span>
        </button>
      </div>
    </div>
    <div class="speech-bubble-tail"></div>
  </div>

  <!-- Prominent Interactive Prompt Pill -->
  <div
    class="char-interaction-trigger"
    id="charInteractBtn"
    aria-label="Click to interact with Hake"
  >
    <span class="trigger-wave-icon" aria-hidden="true">👋</span>
    <span class="trigger-label">Click Hake to talk</span>
    <span class="trigger-pulse"></span>
  </div>
</div>

<style>
  .interactive-character-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 1 / 1;
    border-radius: 28px;
    overflow: visible;
    user-select: none;
    cursor: pointer;
    z-index: 5;
    outline: none;
    animation: gentleBreathe 6s infinite ease-in-out;
  }

  .interactive-character-container.is-talking {
    z-index: 25;
  }

  @keyframes gentleBreathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  .interactive-character-container:focus-visible {
    outline: 2px solid var(--accent, #0055ee);
    outline-offset: 4px;
  }

  /* Master Pose Image Layers (Hardware-accelerated fallback) */
  .char-pose-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
  }

  .char-pose-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 28px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .char-pose-layer.is-active {
    opacity: 1;
    z-index: 2;
  }

  .char-pose-layer.is-hidden {
    opacity: 0;
    z-index: 1;
  }

  /* Video Stage (Direct high-definition video overlay) */
  .video-buffer-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    border-radius: 28px;
    overflow: hidden;
    pointer-events: none;
  }

  .char-video-track {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .char-video-track.is-active {
    opacity: 1;
    z-index: 2;
  }

  .char-video-track.is-hidden {
    opacity: 0;
    z-index: 1;
  }

  /* Interactive Speech Bubble */
  .char-speech-bubble {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(-10px) scale(0.95);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 50;
    width: max-content;
    max-width: min(380px, 90vw);
  }

  .char-speech-bubble.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .speech-bubble-content {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid rgba(0, 85, 238, 0.22);
    border-radius: 20px;
    padding: 16px 20px;
    box-shadow: 0 16px 36px -8px rgba(0, 85, 238, 0.2), 0 0 0 1px rgba(255, 255, 255, 0.85);
  }

  :global(.dark-theme) .speech-bubble-content,
  :global(body.hake-theme-dark) .speech-bubble-content {
    background: rgba(30, 31, 34, 0.94);
    border-color: rgba(56, 189, 248, 0.3);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .speech-bubble-avatar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .speech-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }

  .speech-name {
    font-family: var(--font-heading, Outfit, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary, #0f172a);
    letter-spacing: -0.01em;
  }

  :global(.dark-theme) .speech-name,
  :global(body.hake-theme-dark) .speech-name {
    color: #f1f5f9;
  }

  .speech-text {
    font-size: 0.94rem;
    line-height: 1.45;
    color: var(--text-body, #334155);
    margin: 0 0 14px 0;
    font-weight: 500;
  }

  :global(.dark-theme) .speech-text,
  :global(body.hake-theme-dark) .speech-text {
    color: #cbd5e1;
  }

  .speech-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .speech-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 999px;
    background: #0055ee;
    color: #ffffff;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.dark-theme) .speech-pill-btn,
  :global(body.hake-theme-dark) .speech-pill-btn {
    background: #0284c7;
    color: #ffffff;
  }

  .speech-pill-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 85, 238, 0.28);
  }

  .speech-pill-btn.btn-dismiss {
    background: rgba(100, 116, 139, 0.12);
    color: var(--text-body, #475569);
  }

  :global(.dark-theme) .speech-pill-btn.btn-dismiss,
  :global(body.hake-theme-dark) .speech-pill-btn.btn-dismiss {
    background: rgba(255, 255, 255, 0.08);
    color: #94a3b8;
  }

  .speech-pill-btn.btn-dismiss:hover {
    background: rgba(100, 116, 139, 0.2);
    box-shadow: none;
  }

  .speech-bubble-tail {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid rgba(255, 255, 255, 0.96);
  }

  :global(.dark-theme) .speech-bubble-tail,
  :global(body.hake-theme-dark) .speech-bubble-tail {
    border-top-color: rgba(30, 31, 34, 0.94);
  }

  /* Prominent Interactive Prompt Pill */
  .char-interaction-trigger {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1.5px solid rgba(0, 85, 238, 0.28);
    box-shadow: 0 10px 24px -4px rgba(0, 85, 238, 0.22), 0 0 0 1px rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    padding: 7px 16px;
    pointer-events: auto;
    cursor: pointer;
    z-index: 20;
    transition: opacity 0.3s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.dark-theme) .char-interaction-trigger,
  :global(body.hake-theme-dark) .char-interaction-trigger {
    background: rgba(30, 31, 34, 0.94);
    border-color: rgba(56, 189, 248, 0.35);
    box-shadow: 0 10px 24px -4px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .interactive-character-container:hover .char-interaction-trigger {
    transform: translateX(-50%) scale(1.06);
  }

  .trigger-wave-icon {
    font-size: 1rem;
    line-height: 1;
    animation: triggerWave 2s infinite ease-in-out;
    transform-origin: 70% 70%;
  }

  @keyframes triggerWave {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(14deg); }
    40% { transform: rotate(-8deg); }
    60% { transform: rotate(12deg); }
    80% { transform: rotate(0deg); }
  }

  .trigger-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #0055ee;
    box-shadow: 0 0 8px #0055ee;
    animation: triggerPulse 1.8s infinite ease-in-out;
  }

  :global(.dark-theme) .trigger-pulse,
  :global(body.hake-theme-dark) .trigger-pulse {
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
  }

  @keyframes triggerPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(1.4); }
  }

  .trigger-label {
    font-family: var(--font-heading, Outfit, sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    color: #0055ee;
    letter-spacing: -0.01em;
  }

  :global(.dark-theme) .trigger-label,
  :global(body.hake-theme-dark) .trigger-label {
    color: #38bdf8;
  }
</style>

<script is:inline>
  // Seamless 5-State Interactive Character Motion Engine for Hake
  // 100% Consistent Master Illustrations + Smooth Video Track Playback
  // Zero Stutter, Zero Ghosting, Zero Codec Issues

  class CharacterStateMachine {
    constructor() {
      this.container = null;
      this.poses = { typing: null, wave: null, listen: null };
      this.videos = {
        typing: null,
        transition_wave: null,
        waving: null,
        listening: null,
        transition_typing: null
      };
      this.bubble = null;
      this.triggerBtn = null;
      this.dismissBtn = null;
      this.currentState = 'typing';
      this.waitTimer = null;
      this.transitionWatchdog = null;
      this.waveLoopTimeout = null;
      this.initialized = false;

      this.init();
    }

    clearAllTimers() {
      if (this.transitionWatchdog) {
        clearTimeout(this.transitionWatchdog);
        this.transitionWatchdog = null;
      }
      if (this.waveLoopTimeout) {
        clearTimeout(this.waveLoopTimeout);
        this.waveLoopTimeout = null;
      }
      if (this.waitTimer) {
        clearTimeout(this.waitTimer);
        this.waitTimer = null;
      }
    }

    clearWatchdog() {
      this.clearAllTimers();
    }

    init() {
      if (typeof window === 'undefined') return;
      this.container = document.getElementById('interactiveCharContainer');
      
      // Poses
      this.poses.typing = document.getElementById('poseTyping');
      this.poses.wave = document.getElementById('poseWave');
      this.poses.listen = document.getElementById('poseListen');

      // Videos
      this.videos.typing = document.getElementById('vidTyping');
      this.videos.transition_wave = document.getElementById('vidTransWave');
      this.videos.waving = document.getElementById('vidWaving');
      this.videos.listening = document.getElementById('vidListening');
      this.videos.transition_typing = document.getElementById('vidTransTyping');

      this.bubble = document.getElementById('charSpeechBubble');
      this.triggerBtn = document.getElementById('charInteractBtn');
      this.dismissBtn = document.getElementById('charDismissBtn');

      if (!this.container || !this.poses.typing) return;
      if (this.initialized) return;
      this.initialized = true;

      window.__hakeCharMachine = this;

      // Configure video tracks
      Object.values(this.videos).forEach((v) => {
        if (v) {
          v.muted = true;
          v.playsInline = true;
        }
      });
      if (this.videos.typing) this.videos.typing.loop = true;
      if (this.videos.waving) this.videos.waving.loop = true;
      if (this.videos.listening) this.videos.listening.loop = true;

      // Start base typing video
      if (this.videos.typing) {
        this.videos.typing.play().catch(() => {
          const startOnTouch = () => {
            this.videos.typing?.play().catch(() => {});
            window.removeEventListener('pointerdown', startOnTouch);
          };
          window.addEventListener('pointerdown', startOnTouch, { once: true });
        });
      }

      // Transition Wave ended -> Switch to Waving Greeting
      if (this.videos.transition_wave) {
        this.videos.transition_wave.onended = () => {
          if (this.currentState === 'transition_wave') {
            this.clearAllTimers();
            this.showSpeechBubble();
            this.switchTo('waving');
          }
        };
      }

      // Transition Typing ended -> Return to Base Typing
      if (this.videos.transition_typing) {
        this.videos.transition_typing.onended = () => {
          if (this.currentState === 'transition_typing') {
            this.clearWatchdog();
            this.hideSpeechBubble();
            this.switchTo('typing');
            setTimeout(() => {
              if (this.currentState === 'typing' && this.triggerBtn) {
                this.triggerBtn.style.opacity = '1';
              }
            }, 600);
          }
        };
      }

      // User click triggers state machine
      this.container.addEventListener('click', (e) => {
        const target = e.target;
        if (target && target.closest && target.closest('.speech-pill-btn')) return;
        this.handleUserClick();
      });

      // Keyboard accessibility
      this.container.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          this.handleUserClick();
        }
      });

      // Dismiss button handler (Back to Work)
      if (this.dismissBtn) {
        this.dismissBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          this.transitionToTyping();
        });
      }

      // Explore Services pill click
      const servicePill = this.bubble ? this.bubble.querySelector('[data-action="services"]') : null;
      if (servicePill) {
        servicePill.addEventListener('click', () => {
          this.transitionToTyping();
        });
      }
    }

    isAttached() {
      return !!this.container && document.body.contains(this.container);
    }

    handleUserClick() {
      const now = Date.now();
      if (this.lastClickTime && now - this.lastClickTime < 400) return;
      this.lastClickTime = now;

      if (this.currentState === 'typing') {
        if (this.triggerBtn) this.triggerBtn.style.opacity = '0';
        this.switchTo('transition_wave');
      } else if (this.currentState === 'transition_wave') {
        return;
      } else if (this.currentState === 'transition_typing') {
        this.clearAllTimers();
        this.hideSpeechBubble();
        this.switchTo('typing');
      } else {
        this.transitionToTyping();
      }
    }

    setPoseActive(poseName) {
      Object.entries(this.poses).forEach(([name, el]) => {
        if (!el) return;
        if (name === poseName) {
          el.className = 'char-pose-layer is-active';
        } else {
          el.className = 'char-pose-layer is-hidden';
        }
      });
    }

    switchTo(nextState) {
      this.clearAllTimers();
      this.currentState = nextState;

      // Update matching master pose layer instantly
      const poseMap = {
        typing: 'typing',
        transition_wave: 'wave',
        waving: 'wave',
        listening: 'listen',
        transition_typing: 'typing'
      };
      this.setPoseActive(poseMap[nextState] || 'typing');

      // Synchronously manage playback and reveal video track only when ready
      Object.entries(this.videos).forEach(([key, vid]) => {
        if (!vid) return;
        if (key === nextState) {
          vid.currentTime = 0;
          const playPromise = vid.play();
          if (playPromise) {
            playPromise.catch(() => {});
          }
          if (vid.readyState >= 2) {
            vid.className = 'char-video-track is-active';
          } else {
            vid.className = 'char-video-track is-hidden';
            vid.oncanplay = () => {
              if (this.currentState === key) {
                vid.className = 'char-video-track is-active';
              }
              vid.oncanplay = null;
            };
          }
        } else {
          vid.className = 'char-video-track is-hidden';
          vid.oncanplay = null;
          vid.pause();
        }
      });

      // Safety watchdog timeouts so transitions always complete smoothly
      if (nextState === 'transition_wave') {
        this.transitionWatchdog = window.setTimeout(() => {
          if (this.currentState === 'transition_wave') {
            this.showSpeechBubble();
            this.switchTo('waving');
          }
        }, 850);
      } else if (nextState === 'waving') {
        // Wave for 2.8 seconds then ease into attentive listening
        this.waveLoopTimeout = window.setTimeout(() => {
          if (this.currentState === 'waving') {
            this.switchTo('listening');
          }
        }, 2800);
      } else if (nextState === 'listening') {
        this.startWaitTimer();
      } else if (nextState === 'transition_typing') {
        this.transitionWatchdog = window.setTimeout(() => {
          if (this.currentState === 'transition_typing') {
            this.hideSpeechBubble();
            this.switchTo('typing');
          }
        }, 850);
      }
    }

    startWaitTimer() {
      if (this.waitTimer) clearTimeout(this.waitTimer);
      // Wait 8 seconds in listening state before returning to work
      this.waitTimer = window.setTimeout(() => {
        if (this.currentState === 'listening') {
          this.transitionToTyping();
        }
      }, 8000);
    }

    transitionToTyping() {
      if (this.currentState === 'typing') return;
      this.clearAllTimers();
      this.hideSpeechBubble();
      this.switchTo('transition_typing');
    }

    showSpeechBubble() {
      if (this.bubble) {
        this.bubble.classList.add('active');
        this.bubble.setAttribute('aria-hidden', 'false');
      }
      if (this.container) {
        this.container.classList.add('is-talking');
        const frame = this.container.closest('.art-visual-frame');
        if (frame) frame.classList.add('has-active-dialog');
      }
    }

    hideSpeechBubble() {
      if (this.bubble) {
        this.bubble.classList.remove('active');
        this.bubble.setAttribute('aria-hidden', 'true');
      }
      if (this.container) {
        this.container.classList.remove('is-talking');
        const frame = this.container.closest('.art-visual-frame');
        if (frame) frame.classList.remove('has-active-dialog');
      }
    }
  }

  // Instant robust bootloader
  function bootCharMachine() {
    if (window.__hakeCharMachine && window.__hakeCharMachine.isAttached()) return;
    if (!document.getElementById('interactiveCharContainer')) return;
    new CharacterStateMachine();
  }

  window.bootCharMachine = bootCharMachine;

  // Immediate attempt
  bootCharMachine();

  if (typeof document !== 'undefined') {
    document.addEventListener('DOMContentLoaded', bootCharMachine);
    document.addEventListener('astro:page-load', bootCharMachine);

    // Fast polling fallback to guarantee initialization within milliseconds of element insertion
    const bootInterval = setInterval(() => {
      if (window.__hakeCharMachine && window.__hakeCharMachine.isAttached()) {
        clearInterval(bootInterval);
        return;
      }
      bootCharMachine();
      if (window.__hakeCharMachine && window.__hakeCharMachine.isAttached()) {
        clearInterval(bootInterval);
      }
    }, 40);
    setTimeout(() => clearInterval(bootInterval), 5000);
  }
</script>
