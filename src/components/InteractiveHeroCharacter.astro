---
// InteractiveHeroCharacter.astro
// Bulletproof 5-State Interactive Character Motion Engine for Hake
// States:
// 1. Base Loop: Active typing with continuous steam & periodic coffee sip
// 2. Transition: Typing to Look up & wave
// 3. Greeting: Enthusiastic wave with interactive speech bubble
// 4. Listening: Attentive chin-on-hand listening with dialogue pills
// 5. Transition: Smooth return to laptop keys
---

<div 
  class="interactive-character-container hero-art-asset" 
  id="interactiveCharContainer"
  role="button"
  tabindex="0"
  aria-label="Interactive Hake character. Click to talk with Hake"
  title="Click to interact with Hake"
>
  <!-- Master Illustrated Pose Matrix (Hardware-accelerated, zero-stutter foundation) -->
  <div class="char-pose-stage" id="charPoseStage" aria-hidden="true">
    <img
      src="/assets/character_states/pose_typing.png"
      alt="Hake typing at laptop"
      class="char-pose-layer is-active"
      id="poseTyping"
      width="600"
      height="600"
      loading="eager"
      decoding="async"
    />
    <img
      src="/assets/character_states/pose_coffee.png"
      alt="Hake sipping coffee"
      class="char-pose-layer is-hidden"
      id="poseCoffee"
      width="600"
      height="600"
      loading="eager"
      decoding="async"
    />
    <img
      src="/assets/character_states/pose_wave.png"
      alt="Hake waving hello"
      class="char-pose-layer is-hidden"
      id="poseWave"
      width="600"
      height="600"
      loading="eager"
      decoding="async"
    />
    <img
      src="/assets/character_states/pose_listen.png"
      alt="Hake listening attentively"
      class="char-pose-layer is-hidden"
      id="poseListen"
      width="600"
      height="600"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- 5-State Dedicated Preloaded Video Track Stage -->
  <div class="video-buffer-stage" id="videoBufferStage" aria-hidden="true">
    <!-- State 1: Base Typing & Coffee Loop -->
    <video
      id="vidTyping"
      class="char-video-track is-active"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      src="/assets/character_states/clip_1_typing_loop.mp4"
    ></video>

    <!-- State 2: Transition Typing to Wave -->
    <video
      id="vidTransWave"
      class="char-video-track is-hidden"
      muted
      playsinline
      preload="auto"
      src="/assets/character_states/clip_2_typing_to_wave.mp4"
    ></video>

    <!-- State 3: Waving Greeting -->
    <video
      id="vidWaving"
      class="char-video-track is-hidden"
      muted
      playsinline
      preload="auto"
      src="/assets/character_states/clip_3_waving_speech.mp4"
    ></video>

    <!-- State 4: Listening Wait -->
    <video
      id="vidListening"
      class="char-video-track is-hidden"
      muted
      loop
      playsinline
      preload="auto"
      src="/assets/character_states/clip_4_listening_wait.mp4"
    ></video>

    <!-- State 5: Transition Listening to Typing -->
    <video
      id="vidTransTyping"
      class="char-video-track is-hidden"
      muted
      playsinline
      preload="auto"
      src="/assets/character_states/clip_5_listen_to_typing.mp4"
    ></video>
  </div>

  <!-- Live Dynamic FX Layer: Rising Steam & Typing Light -->
  <div class="char-live-fx" id="charLiveFx" aria-hidden="true">
    <!-- Steam from Discord mug (left: 6.5%, bottom: 27%) -->
    <div class="steam-container">
      <span class="steam-puff puff-1"></span>
      <span class="steam-puff puff-2"></span>
      <span class="steam-puff puff-3"></span>
    </div>
    <!-- Subtle keystroke glow on keyboard -->
    <div class="keystroke-glow" id="keystrokeGlow"></div>
  </div>

  <!-- Interactive Speech Bubble (State 3 & 4) -->
  <div class="char-speech-bubble" id="charSpeechBubble" aria-live="polite" aria-hidden="true">
    <div class="speech-bubble-content">
      <div class="speech-bubble-avatar">
        <span class="speech-status-dot"></span>
        <span class="speech-name">hake.</span>
      </div>
      <p class="speech-text">
        Hey! I'm Hake. Wanna know what I can build for your community?
      </p>
      <div class="speech-actions">
        <a href="#services" class="speech-pill-btn" data-action="services">
          <span>Explore Services</span>
        </a>
        <a href="/experience" class="speech-pill-btn" data-action="cases">
          <span>Case Studies</span>
        </a>
        <button type="button" class="speech-pill-btn btn-dismiss" id="charDismissBtn" aria-label="Dismiss greeting and return to work">
          <span>Back to Work</span>
        </button>
      </div>
    </div>
    <div class="speech-bubble-tail"></div>
  </div>

  <!-- Prominent Interactive Prompt Pill -->
  <div
    class="char-interaction-trigger"
    id="charInteractBtn"
    aria-label="Click to interact with Hake"
  >
    <span class="trigger-wave-icon" aria-hidden="true">👋</span>
    <span class="trigger-label">Click Hake to talk</span>
    <span class="trigger-pulse"></span>
  </div>
</div>

<style>
  .interactive-character-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 1 / 1;
    border-radius: 28px;
    overflow: visible;
    user-select: none;
    cursor: pointer;
    z-index: 25;
    outline: none;
    animation: gentleBreathe 6s infinite ease-in-out;
  }

  @keyframes gentleBreathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  .interactive-character-container:focus-visible {
    outline: 2px solid var(--accent, #0055ee);
    outline-offset: 4px;
  }

  /* Master Pose Image Layers (Always available, instant 60fps response) */
  .char-pose-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
  }

  .char-pose-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 28px;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .char-pose-layer.is-active {
    opacity: 1;
    transform: scale(1);
    z-index: 2;
  }

  .char-pose-layer.is-hidden {
    opacity: 0;
    transform: scale(0.99);
    z-index: 1;
  }

  /* Video Stage (Direct high-definition motion overlay) */
  .video-buffer-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    border-radius: 28px;
    overflow: hidden;
    pointer-events: none;
  }

  .char-video-track {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    transition: opacity 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .char-video-track.is-active {
    opacity: 1;
    z-index: 2;
  }

  .char-video-track.is-hidden {
    opacity: 0;
    z-index: 1;
  }

  /* Live Dynamic FX Layer */
  .char-live-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }

  /* Rising Steam from Mug */
  .steam-container {
    position: absolute;
    left: 7%;
    bottom: 27%;
    width: 32px;
    height: 64px;
    pointer-events: none;
  }

  .steam-puff {
    position: absolute;
    bottom: 0;
    left: 50%;
    border-radius: 50%;
    background: rgba(235, 240, 255, 0.85);
    filter: blur(4px);
    opacity: 0;
    transform: translateX(-50%);
  }

  .puff-1 {
    width: 14px;
    height: 14px;
    animation: steamFloat 2.4s infinite ease-out;
  }

  .puff-2 {
    width: 18px;
    height: 18px;
    animation: steamFloat 2.4s infinite ease-out 0.8s;
  }

  .puff-3 {
    width: 12px;
    height: 12px;
    animation: steamFloat 2.4s infinite ease-out 1.6s;
  }

  @keyframes steamFloat {
    0% {
      opacity: 0;
      transform: translateX(-50%) translateY(0) scale(0.6);
    }
    30% {
      opacity: 0.75;
      transform: translateX(calc(-50% + 4px)) translateY(-20px) scale(1);
    }
    70% {
      opacity: 0.4;
      transform: translateX(calc(-50% - 6px)) translateY(-45px) scale(1.4);
    }
    100% {
      opacity: 0;
      transform: translateX(calc(-50% + 8px)) translateY(-70px) scale(1.8);
    }
  }

  /* Keystroke Reflection Glow */
  .keystroke-glow {
    position: absolute;
    left: 36%;
    bottom: 20%;
    width: 170px;
    height: 50px;
    background: radial-gradient(ellipse at center, rgba(56, 189, 248, 0.28) 0%, rgba(0, 85, 238, 0.08) 55%, transparent 75%);
    filter: blur(8px);
    border-radius: 50%;
    pointer-events: none;
    animation: glowFlicker 0.45s infinite ease-in-out alternate;
  }

  @keyframes glowFlicker {
    0% { opacity: 0.35; transform: scale(0.96); }
    100% { opacity: 0.85; transform: scale(1.04); }
  }

  /* Interactive Speech Bubble */
  .char-speech-bubble {
    position: absolute;
    top: -42px;
    left: 50%;
    transform: translateX(-50%) translateY(-8px) scale(0.94);
    width: min(320px, 92vw);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(0, 85, 238, 0.18);
    box-shadow: 0 16px 36px -10px rgba(0, 85, 238, 0.16), 0 0 0 1px rgba(255, 255, 255, 0.8);
    border-radius: 18px;
    padding: 14px 16px;
    z-index: 50;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1), transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.dark-theme) .char-speech-bubble,
  :global(body.hake-theme-dark) .char-speech-bubble {
    background: rgba(30, 31, 34, 0.94);
    border-color: rgba(56, 189, 248, 0.25);
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .char-speech-bubble.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .speech-bubble-avatar {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .speech-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: statusPulse 2s infinite ease-in-out;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 0.9; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .speech-name {
    font-family: var(--font-heading, Outfit, sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-heading, #0f172a);
    letter-spacing: -0.01em;
  }

  :global(.dark-theme) .speech-name,
  :global(body.hake-theme-dark) .speech-name {
    color: #f1f5f9;
  }

  .speech-text {
    font-size: 0.88rem;
    line-height: 1.38;
    color: var(--text-body, #334155);
    margin: 0 0 12px 0;
    font-family: var(--font-body, "DM Sans", sans-serif);
  }

  :global(.dark-theme) .speech-text,
  :global(body.hake-theme-dark) .speech-text {
    color: #cbd5e1;
  }

  .speech-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .speech-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 11px;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 600;
    background: #0055ee;
    color: #ffffff;
    text-decoration: none;
    border: none;
    cursor: pointer;
    pointer-events: auto;
    transition: all 0.16s ease;
  }

  :global(.dark-theme) .speech-pill-btn,
  :global(body.hake-theme-dark) .speech-pill-btn {
    background: #0284c7;
    color: #ffffff;
  }

  .speech-pill-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 85, 238, 0.28);
  }

  .speech-pill-btn.btn-dismiss {
    background: rgba(100, 116, 139, 0.12);
    color: var(--text-body, #475569);
  }

  :global(.dark-theme) .speech-pill-btn.btn-dismiss,
  :global(body.hake-theme-dark) .speech-pill-btn.btn-dismiss {
    background: rgba(255, 255, 255, 0.08);
    color: #94a3b8;
  }

  .speech-pill-btn.btn-dismiss:hover {
    background: rgba(100, 116, 139, 0.2);
    box-shadow: none;
  }

  .speech-bubble-tail {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid rgba(255, 255, 255, 0.96);
  }

  :global(.dark-theme) .speech-bubble-tail,
  :global(body.hake-theme-dark) .speech-bubble-tail {
    border-top-color: rgba(30, 31, 34, 0.94);
  }

  /* Prominent Interactive Prompt Pill */
  .char-interaction-trigger {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1.5px solid rgba(0, 85, 238, 0.28);
    box-shadow: 0 10px 24px -4px rgba(0, 85, 238, 0.22), 0 0 0 1px rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    padding: 7px 16px;
    pointer-events: none;
    z-index: 20;
    transition: opacity 0.3s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.dark-theme) .char-interaction-trigger,
  :global(body.hake-theme-dark) .char-interaction-trigger {
    background: rgba(30, 31, 34, 0.94);
    border-color: rgba(56, 189, 248, 0.35);
    box-shadow: 0 10px 24px -4px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .interactive-character-container:hover .char-interaction-trigger {
    transform: translateX(-50%) scale(1.06);
  }

  .trigger-wave-icon {
    font-size: 1rem;
    line-height: 1;
    animation: triggerWave 2s infinite ease-in-out;
    transform-origin: 70% 70%;
  }

  @keyframes triggerWave {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(14deg); }
    40% { transform: rotate(-8deg); }
    60% { transform: rotate(12deg); }
    80% { transform: rotate(0deg); }
  }

  .trigger-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #0055ee;
    box-shadow: 0 0 8px #0055ee;
    animation: triggerPulse 1.8s infinite ease-in-out;
  }

  :global(.dark-theme) .trigger-pulse,
  :global(body.hake-theme-dark) .trigger-pulse {
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
  }

  @keyframes triggerPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(1.4); }
  }

  .trigger-label {
    font-family: var(--font-heading, Outfit, sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    color: #0055ee;
    letter-spacing: -0.01em;
  }

  :global(.dark-theme) .trigger-label,
  :global(body.hake-theme-dark) .trigger-label {
    color: #38bdf8;
  }
</style>

<script>
  // Robust Multi-Layer 5-State Interactive Character Motion Engine
  // Synchronizes illustrated master poses and smooth video playback
  // Completely immune to autoplay blocks, sleep states, or network stalls

  type CharacterState = 'typing' | 'coffee' | 'transition_wave' | 'waving' | 'listening' | 'transition_typing';

  class CharacterStateMachine {
    private container: HTMLElement | null = null;
    
    // Poses
    private poses: Record<string, HTMLImageElement | null> = {
      typing: null,
      coffee: null,
      wave: null,
      listen: null,
    };

    // Video tracks
    private videos: Record<string, HTMLVideoElement | null> = {
      typing: null,
      transition_wave: null,
      waving: null,
      listening: null,
      transition_typing: null,
    };

    private bubble: HTMLElement | null = null;
    private triggerBtn: HTMLElement | null = null;
    private dismissBtn: HTMLElement | null = null;
    private keystrokeGlow: HTMLElement | null = null;

    private currentState: CharacterState = 'typing';
    private waitTimer: number | null = null;
    private transitionWatchdog: number | null = null;
    private coffeeLoopTimer: number | null = null;
    private initialized: boolean = false;

    constructor() {
      this.init();
    }

    private clearWatchdog() {
      if (this.transitionWatchdog) {
        clearTimeout(this.transitionWatchdog);
        this.transitionWatchdog = null;
      }
    }

    public init() {
      if (typeof window === 'undefined') return;
      this.container = document.getElementById('interactiveCharContainer');
      
      // Poses
      this.poses.typing = document.getElementById('poseTyping') as HTMLImageElement;
      this.poses.coffee = document.getElementById('poseCoffee') as HTMLImageElement;
      this.poses.wave = document.getElementById('poseWave') as HTMLImageElement;
      this.poses.listen = document.getElementById('poseListen') as HTMLImageElement;

      // Videos
      this.videos.typing = document.getElementById('vidTyping') as HTMLVideoElement;
      this.videos.transition_wave = document.getElementById('vidTransWave') as HTMLVideoElement;
      this.videos.waving = document.getElementById('vidWaving') as HTMLVideoElement;
      this.videos.listening = document.getElementById('vidListening') as HTMLVideoElement;
      this.videos.transition_typing = document.getElementById('vidTransTyping') as HTMLVideoElement;

      this.bubble = document.getElementById('charSpeechBubble');
      this.triggerBtn = document.getElementById('charInteractBtn');
      this.dismissBtn = document.getElementById('charDismissBtn');
      this.keystrokeGlow = document.getElementById('keystrokeGlow');

      if (!this.container || !this.poses.typing) return;
      if (this.initialized) return;
      this.initialized = true;

      // Configure video elements with muted and playsInline for browser policies
      Object.values(this.videos).forEach((v) => {
        if (v) {
          v.muted = true;
          v.playsInline = true;
        }
      });
      if (this.videos.listening) {
        this.videos.listening.loop = true;
      }

      // Start typing video loop
      if (this.videos.typing) {
        this.videos.typing.loop = true;
        this.videos.typing.play().catch(() => {
          // Strict browser policy: start on first touch/pointer
          const startOnTouch = () => {
            this.videos.typing?.play().catch(() => {});
            window.removeEventListener('pointerdown', startOnTouch);
          };
          window.addEventListener('pointerdown', startOnTouch, { once: true });
        });

        this.videos.typing.onended = () => {
          if (this.currentState === 'typing' && this.videos.typing) {
            this.videos.typing.currentTime = 0;
            this.videos.typing.play().catch(() => {});
          }
        };
      }

      // Start periodic coffee sip cycle in State 1
      this.scheduleCoffeeSip();

      // Video event: Transition Wave ended -> Waving
      if (this.videos.transition_wave) {
        this.videos.transition_wave.onended = () => {
          if (this.currentState === 'transition_wave') {
            this.clearWatchdog();
            this.showSpeechBubble();
            this.switchTo('waving');
          }
        };
      }

      // Video event: Waving ended -> Listening
      if (this.videos.waving) {
        this.videos.waving.onended = () => {
          if (this.currentState === 'waving') {
            this.clearWatchdog();
            this.switchTo('listening');
            this.startWaitTimer();
          }
        };
      }

      // Video event: Transition Typing ended -> Return to Typing
      if (this.videos.transition_typing) {
        this.videos.transition_typing.onended = () => {
          if (this.currentState === 'transition_typing') {
            this.clearWatchdog();
            this.hideSpeechBubble();
            this.switchTo('typing');
            setTimeout(() => {
              if (this.currentState === 'typing' && this.triggerBtn) {
                this.triggerBtn.style.opacity = '1';
              }
            }, 800);
          }
        };
      }

      // User click triggers state machine
      this.container.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.speech-pill-btn')) return;
        this.handleUserClick();
      });

      // Touch support for mobile devices
      this.container.addEventListener('touchstart', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.speech-pill-btn')) return;
      }, { passive: true });

      // Keyboard accessibility
      this.container.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          this.handleUserClick();
        }
      });

      // Dismiss button handler (Back to Work)
      this.dismissBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.transitionToTyping();
      });

      // Explore Services pill click
      const servicePill = this.bubble?.querySelector('[data-action="services"]');
      servicePill?.addEventListener('click', () => {
        this.transitionToTyping();
      });
    }

    private scheduleCoffeeSip() {
      if (this.coffeeLoopTimer) clearTimeout(this.coffeeLoopTimer);
      // Take a coffee sip every 7.5 seconds in base loop
      this.coffeeLoopTimer = window.setTimeout(() => {
        if (this.currentState === 'typing') {
          this.performCoffeeSip();
        }
      }, 7500);
    }

    private performCoffeeSip() {
      if (this.currentState !== 'typing') return;
      this.currentState = 'coffee';
      this.setPoseActive('coffee');
      
      // Sips for 2.4 seconds with eyes closed & mug raised
      setTimeout(() => {
        if (this.currentState === 'coffee') {
          this.currentState = 'typing';
          this.setPoseActive('typing');
          this.scheduleCoffeeSip();
        }
      }, 2400);
    }

    private handleUserClick() {
      if (this.coffeeLoopTimer) {
        clearTimeout(this.coffeeLoopTimer);
        this.coffeeLoopTimer = null;
      }

      if (this.currentState === 'typing' || this.currentState === 'coffee') {
        if (this.triggerBtn) this.triggerBtn.style.opacity = '0';
        this.switchTo('transition_wave');
      } else if (this.currentState === 'transition_typing') {
        // Instant complete back to desk
        this.clearWatchdog();
        this.hideSpeechBubble();
        this.switchTo('typing');
      } else {
        // In waving or listening: immediately transition back to work
        this.transitionToTyping();
      }
    }

    private setPoseActive(poseName: 'typing' | 'coffee' | 'wave' | 'listen') {
      Object.entries(this.poses).forEach(([name, el]) => {
        if (!el) return;
        if (name === poseName) {
          el.className = 'char-pose-layer is-active';
        } else {
          el.className = 'char-pose-layer is-hidden';
        }
      });
    }

    private switchTo(nextState: CharacterState) {
      this.clearWatchdog();
      const prevVideoKey = this.currentState === 'coffee' ? 'typing' : this.currentState;
      const prevVideo = this.videos[prevVideoKey];
      
      this.currentState = nextState;

      // Synchronize Illustrated Pose Layer immediately (0ms latency)
      if (nextState === 'typing') {
        this.setPoseActive('typing');
        if (this.keystrokeGlow) this.keystrokeGlow.style.opacity = '1';
        this.scheduleCoffeeSip();
      } else if (nextState === 'coffee') {
        this.setPoseActive('coffee');
      } else if (nextState === 'transition_wave' || nextState === 'waving') {
        this.setPoseActive('wave');
        if (this.keystrokeGlow) this.keystrokeGlow.style.opacity = '0';
      } else if (nextState === 'listening') {
        this.setPoseActive('listen');
        if (this.keystrokeGlow) this.keystrokeGlow.style.opacity = '0';
      } else if (nextState === 'transition_typing') {
        this.setPoseActive('typing');
      }

      // Synchronize Video Track Layer
      const videoKeyMap: Record<string, string> = {
        typing: 'typing',
        coffee: 'typing',
        transition_wave: 'transition_wave',
        waving: 'waving',
        listening: 'listening',
        transition_typing: 'transition_typing',
      };
      const nextVideoKey = videoKeyMap[nextState];
      const nextVideo = this.videos[nextVideoKey];

      // Watchdog safety timeouts so transitions always complete
      if (nextState === 'transition_wave') {
        this.transitionWatchdog = window.setTimeout(() => {
          if (this.currentState === 'transition_wave') {
            this.showSpeechBubble();
            this.switchTo('waving');
          }
        }, 1400);
      } else if (nextState === 'waving') {
        this.transitionWatchdog = window.setTimeout(() => {
          if (this.currentState === 'waving') {
            this.switchTo('listening');
            this.startWaitTimer();
          }
        }, 3400);
      } else if (nextState === 'transition_typing') {
        this.transitionWatchdog = window.setTimeout(() => {
          if (this.currentState === 'transition_typing') {
            this.hideSpeechBubble();
            this.switchTo('typing');
          }
        }, 1200);
      }

      if (nextVideo) {
        nextVideo.muted = true;
        nextVideo.playsInline = true;
        nextVideo.currentTime = 0;
        nextVideo.play().then(() => {
          nextVideo.className = 'char-video-track is-active';
          if (prevVideo && prevVideo !== nextVideo) {
            prevVideo.className = 'char-video-track is-hidden';
            setTimeout(() => {
              if (prevVideo.className.includes('is-hidden')) {
                prevVideo.pause();
              }
            }, 200);
          }
        }).catch(() => {
          // Direct fallback: make active anyway
          nextVideo.className = 'char-video-track is-active';
          if (prevVideo && prevVideo !== nextVideo) {
            prevVideo.className = 'char-video-track is-hidden';
          }
        });
      }
    }

    private startWaitTimer() {
      if (this.waitTimer) clearTimeout(this.waitTimer);
      this.waitTimer = window.setTimeout(() => {
        if (this.currentState === 'listening') {
          this.transitionToTyping();
        }
      }, 5000);
    }

    private transitionToTyping() {
      if (this.currentState === 'typing') return;
      if (this.waitTimer) {
        clearTimeout(this.waitTimer);
        this.waitTimer = null;
      }
      this.clearWatchdog();
      this.hideSpeechBubble();
      this.switchTo('transition_typing');
    }

    private showSpeechBubble() {
      this.bubble?.classList.add('active');
      this.bubble?.setAttribute('aria-hidden', 'false');
    }

    private hideSpeechBubble() {
      this.bubble?.classList.remove('active');
      this.bubble?.setAttribute('aria-hidden', 'true');
    }
  }

  // Initialize on load and on Astro view transition navigation
  let stateMachine: CharacterStateMachine | null = null;
  function initCharMachine() {
    if (!stateMachine) {
      stateMachine = new CharacterStateMachine();
    } else {
      stateMachine.init();
    }
  }

  initCharMachine();
  document.addEventListener('astro:page-load', () => {
    stateMachine = null;
    initCharMachine();
  });
</script>
