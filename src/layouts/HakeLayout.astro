---
// HakeLayout.astro - Universal Layout for Multi-Page Hake Portfolio
// Provides sticky navbar, theme toggle, mobile drawer, social dock, quickbar, footer, and styling
import '../styles/hake-theme.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: "home" | "services" | "experience" | "about" | "contact";
}

const {
  title = "hake. | Discord Server Manager & Creator Services Coordinator",
  description = "Official portfolio of Hake. Discord server manager and creator services coordinator helping YouTubers and gaming communities with clean server architecture, bot automation, video editing coordination, and sponsorships.",
  activePage = "home",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1e1f22" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hake_acc" />

    <!-- Google Fonts: Outfit (Headings) & DM Sans (Body) - Preconnected & Preloaded -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&family=Outfit:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&family=Outfit:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&family=Outfit:wght@400;500;600;700;800&display=swap" />
    </noscript>

    <!-- Zero FOUC Theme & Underline Cache Init -->
    <script is:inline>
      (function() {
        try {
          var savedTheme = localStorage.getItem('hake-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = savedTheme ? savedTheme : (prefersDark ? 'dark' : 'light');
          document.documentElement.classList.toggle('dark-theme', theme === 'dark');
          document.body && (document.body.className = theme === 'dark' ? 'hake-theme-dark' : 'hake-theme-light');
          
          if (sessionStorage.getItem('hake_underline_cached') === 'true') {
            document.documentElement.classList.add('underline-cached-mode');
          }
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="hake-theme-light">
    <!-- Responsive Viewport Wrapper -->
    <div class="hake-viewport-wrapper">
      
      <!-- Main Canvas Container -->
      <div class="hake-page-container" id="landing-root">
        
        <!-- Faint Background Structural Geometry (No Harsh Glows) -->
        <div class="bg-geometry-decor" aria-hidden="true">
          <!-- Concentric Orbit Ring Behind Header/Hero -->
          <svg class="bg-circle-orbit" viewBox="0 0 700 700" fill="none">
            <circle cx="350" cy="350" r="300" stroke="currentColor" stroke-width="1.5" stroke-dasharray="10 14" opacity="0.14" />
            <circle cx="350" cy="350" r="210" stroke="currentColor" stroke-width="1" opacity="0.08" />
          </svg>
          <!-- Sweeping Curved Fluid Baseline Across Page -->
          <svg class="bg-sweeping-curve" viewBox="0 0 1440 600" fill="none" preserveAspectRatio="none">
            <path d="M-80 320 C 350 480, 850 140, 1520 380" stroke="currentColor" stroke-width="1.8" stroke-dasharray="8 10" opacity="0.12" />
          </svg>
        </div>

        <!-- ====================================================
             1. HEADER NAVIGATION
             ==================================================== -->
        <header class="hake-navbar" id="siteHeader">
          <div class="nav-brand">
            <a href="/" class="brand-logo" aria-label="hake home">
              <span class="brand-text">hake</span><span class="brand-dot">.</span>
            </a>
          </div>

          <nav class="nav-links" aria-label="Main Navigation">
            <a href="/" class={`nav-item ${activePage === "home" ? "active" : ""}`}>Home</a>
            <a href="/services" class={`nav-item ${activePage === "services" ? "active" : ""}`}>Services</a>
            <a href="/experience" class={`nav-item ${activePage === "experience" ? "active" : ""}`}>Case Studies</a>
            <a href="/about" class={`nav-item ${activePage === "about" ? "active" : ""}`}>About</a>
            <a href="/contact" class={`nav-item ${activePage === "contact" ? "active" : ""}`}>Contact</a>
          </nav>

          <div class="nav-actions">
            <a href="/contact" class="btn-cta-nav">
              <span>Let's Work Together</span>
              <svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            
            <button class="theme-toggle-btn" id="themeToggle" aria-label="Toggle light or dark theme" title="Toggle Theme">
              <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
              <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
            </button>

            <!-- Mobile Hamburger Button -->
            <button class="mobile-menu-btn" id="mobileMenuToggle" aria-label="Open mobile navigation menu" aria-expanded="false" aria-controls="mobileDrawer">
              <span class="hamburger-line"></span>
              <span class="hamburger-line"></span>
              <span class="hamburger-line"></span>
            </button>
          </div>
        </header>

        <!-- ====================================================
             2. FLOATING SOCIAL DOCK (DESKTOP ONLY)
             ==================================================== -->
        <aside class="floating-dock" aria-label="Social Profiles">
          <div class="dock-capsule">
            <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="dock-btn" aria-label="Discord: hake_acc" title="Discord: hake_acc">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
            </a>
            <a href="https://twitter.com/hake_acc" target="_blank" rel="noopener noreferrer" class="dock-btn" aria-label="Twitter / X: @hake_acc" title="Twitter / X: @hake_acc">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="dock-btn" aria-label="YouTube Creator Network" title="YouTube Network">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
            <a href="mailto:contact@hakeacc.com" class="dock-btn" aria-label="Direct Email" title="Email: contact@hakeacc.com">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </a>
          </div>
        </aside>

        <!-- Main Page Content Slot -->
        <main class="hake-main-flow" id="mainContent">
          <slot />
        </main>

        <!-- ====================================================
             SITE FOOTER
             ==================================================== -->
        <footer class="hake-site-footer" id="site-footer">
          <!-- Ambient Footer CTA Card -->
          <div class="footer-cta-card">
            <div class="footer-cta-text">
              <span class="footer-cta-eyebrow">Ready to scale your community?</span>
              <h3 class="footer-cta-title">Let's build a high-retention creator ecosystem.</h3>
              <p class="footer-cta-desc">Full-cycle Discord management, brand sponsorship coordination, and content operations tailored for gaming creators.</p>
            </div>
            <div class="footer-cta-actions">
              <a href="/contact" class="btn-primary-action footer-cta-btn">
                <span>Start a Project</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
              <a href="/experience" class="btn-secondary-action footer-cta-sec-btn">
                <span>View Case Studies</span>
              </a>
            </div>
          </div>

          <!-- Main Structured Footer Grid -->
          <div class="footer-grid-layout">
            <!-- Col 1: Brand & Status -->
            <div class="footer-col footer-col-brand">
              <a href="/" class="brand-logo footer-logo">
                <span class="brand-text">hake</span><span class="brand-dot">.</span>
              </a>
              <p class="footer-brand-bio">
                Discord community architect &amp; creator services coordinator. Building retention-engineered server infrastructure and content workflows for top YouTubers.
              </p>

              <!-- Direct Discord Handle Pill -->
              <div class="footer-handle-pill" title="Discord: hake_acc">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
                <span>Discord: <strong>hake_acc</strong></span>
              </div>
            </div>

            <!-- Col 2: Navigation -->
            <div class="footer-col">
              <h4 class="footer-heading">Navigation</h4>
              <ul class="footer-nav-links">
                <li><a href="/" class="footer-link">Home</a></li>
                <li><a href="/services" class="footer-link">Services</a></li>
                <li><a href="/experience" class="footer-link">Case Studies</a></li>
                <li><a href="/about" class="footer-link">About Hake</a></li>
                <li><a href="/contact" class="footer-link">Contact</a></li>
              </ul>
            </div>

            <!-- Col 3: Capabilities -->
            <div class="footer-col">
              <h4 class="footer-heading">Capabilities</h4>
              <ul class="footer-nav-links">
                <li><a href="/services" class="footer-link">Discord Architecture</a></li>
                <li><a href="/services" class="footer-link">Sponsorships &amp; Brand Deals</a></li>
                <li><a href="/services" class="footer-link">Content Pipeline Flow</a></li>
                <li><a href="/services" class="footer-link">Custom Bot Systems</a></li>
                <li><a href="/services" class="footer-link">Weekly Metric Audits</a></li>
              </ul>
            </div>

            <!-- Col 4: Connect & Profiles -->
            <div class="footer-col footer-col-connect">
              <h4 class="footer-heading">Connect</h4>
              <p class="footer-connect-desc">Direct inquiries &amp; partnership requests:</p>
              <div class="footer-social-cluster">
                <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="social-touch-btn" aria-label="Discord: hake_acc" title="Discord: hake_acc">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
              </a>
              <a href="https://twitter.com/hake_acc" target="_blank" rel="noopener noreferrer" class="social-touch-btn" aria-label="Twitter / X: @hake_acc" title="Twitter / X: @hake_acc">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
              <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-touch-btn" aria-label="YouTube" title="YouTube">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
              <a href="mailto:contact@hakeacc.com" class="social-touch-btn" aria-label="Email: contact@hakeacc.com" title="Email: contact@hakeacc.com">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Bottom Legal & Status Sub-bar -->
        <div class="footer-bottom-bar">
          <div class="footer-bottom-left">
            <span class="footer-copyright">&copy; 2026 hake. All rights reserved.</span>
            <span class="footer-dot-divider">&bull;</span>
            <span class="footer-descriptor">High-retention creator ecosystems &amp; Discord architecture.</span>
          </div>
          <a href="#" onclick="window.scrollTo({top:0, behavior:'smooth'}); return false;" class="back-to-top-btn" aria-label="Back to top">
            <span>Back to top</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </a>
        </div>
      </footer>

      </div> <!-- /hake-page-container -->
    </div> <!-- /hake-viewport-wrapper -->

    <!-- Mobile Drawer Navigation -->
    <div class="mobile-drawer-overlay" id="mobileDrawerOverlay" aria-hidden="true"></div>
    <div class="mobile-drawer-panel" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation Menu" inert>
      <div class="drawer-header">
        <span class="drawer-brand-logo">
          <span class="brand-text">hake</span><span class="brand-dot">.</span>
        </span>
        <button class="drawer-close-btn" id="mobileDrawerClose" aria-label="Close menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="drawer-nav-list" aria-label="Mobile Drawer Navigation">
        <a href="/" class={`drawer-nav-item ${activePage === "home" ? "active" : ""}`}>
          <span>Home</span>
          <span class="drawer-arrow">&rarr;</span>
        </a>
        <a href="/services" class={`drawer-nav-item ${activePage === "services" ? "active" : ""}`}>
          <span>Services</span>
          <span class="drawer-arrow">&rarr;</span>
        </a>
        <a href="/experience" class={`drawer-nav-item ${activePage === "experience" ? "active" : ""}`}>
          <span>Case Studies</span>
          <span class="drawer-arrow">&rarr;</span>
        </a>
        <a href="/about" class={`drawer-nav-item ${activePage === "about" ? "active" : ""}`}>
          <span>About</span>
          <span class="drawer-arrow">&rarr;</span>
        </a>
        <a href="/contact" class={`drawer-nav-item ${activePage === "contact" ? "active" : ""}`}>
          <span>Contact</span>
          <span class="drawer-arrow">&rarr;</span>
        </a>
      </nav>

      <div class="drawer-cta-wrapper">
        <a href="/contact" class="drawer-inquire-btn">
          <span>Let's Work Together</span>
        </a>
      </div>
    </div>

    <!-- Mobile Bottom Quickbar -->
    <div class="mobile-quickbar" role="navigation" aria-label="Mobile Quickbar">
      <div class="quickbar-container">
        <a href="/" class="quickbar-action-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Home</span>
        </a>
        <a href="/services" class="quickbar-action-item">
