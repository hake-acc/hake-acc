---
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";
import CrtOverlay from "@/components/CrtOverlay";
import KonamiEasterEgg from "@/components/KonamiEasterEgg";
import RetroHudFooter from "@/components/RetroHudFooter";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Hake Acc — Social Media Manager, Discord Architect & Creator Agency Founder",
  description = "Official portfolio of Hake Acc. Senior content strategist and Discord architect managing top YouTubers, scaling communities, and engineering high-retention creator ecosystems.",
  image = "/assets/hake-logo.png",
  canonicalURL = "https://hakeacc.com",
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Hake Acc",
  jobTitle: "Senior Content Strategist, Discord Architect & Creator Agency Founder",
  url: "https://hakeacc.com",
  image: "https://hakeacc.com/assets/hake-logo.png",
  sameAs: [
    "https://github.com/hake-acc",
    "https://twitter.com/hake_acc",
    "https://youtube.com",
  ],
  knowsAbout: [
    "YouTube Channel Management",
    "Social Media Strategy",
    "Discord Server Architecture",
    "Custom Discord Bot Development",
    "Audience Retention & SEO",
    "Creator Talent Management",
    "Community Building",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Hake Acc, Social Media Manager, Discord Server Developer, Discord Architect, Content Strategist, Agency Founder, YouTube Channel Manager, Creator Manager, Discord Bot Developer, Community Growth" />
    <meta name="author" content="Hake Acc" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f59e0b" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/assets/hake-logo.png" />
    <link rel="apple-touch-icon" href="/assets/hake-logo.png" />
    <link rel="shortcut icon" href="/assets/hake-logo.png" />

    <!-- Open Graph / Discord / Facebook / LinkedIn Embeds -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Hake Acc Portfolio" />

    <!-- Twitter / X Embeds -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:creator" content="@hake_acc" />

    <!-- Optimized Google Fonts with display=swap for 100/100 Lighthouse Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,600;0,700;1,400&family=Pixelify+Sans:wght@400;600;700&family=Press+Start+2P&family=Silkscreen:wght@400;700&family=VT323&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Astro View Transitions for instant SPA-like navigation -->
    <ClientRouter />
  </head>
  <body class="font-readable antialiased bg-[#090a0f] text-[#f8fafc] selection:bg-amber/30 selection:text-white">
    <!-- GPU-Accelerated CRT Scanline / Vignette Overlay -->
    <CrtOverlay client:load />

    <!-- Keyboard Konami Code Easter Egg Subsystem -->
    <KonamiEasterEgg client:load />

    <!-- Background Arcade Pixel Grid -->
    <div class="pixel-grid fixed inset-0 z-0 pointer-events-none opacity-40"></div>

    <!-- Main Page Slots -->
    <div class="relative z-10">
      <slot />
    </div>

    <!-- Fixed Retro HUD Footer Bar (Docked at Bottom) -->
    <RetroHudFooter client:load />
  </body>
</html>
